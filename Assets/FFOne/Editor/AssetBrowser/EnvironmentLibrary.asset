    AssemblyGuid: 511be70dc535446419848114972f7845
    AssemblyStatus: "\u0420\u040E\u0421\u201A\u0420\xB0\u0421\u201A\u0420\u0451\u0421\u2021\u0420\xB5\u0421\u0403\u0420\u0454\u0420\u0451\u0420\u2116
      MeshCollider \u0420\u0457\u0420\u0455 \u0420\u0406\u0420\u0451\u0420\xB7\u0421\u0453\u0420\xB0\u0420\xBB\u0421\u040A\u0420\u0405\u0420\u0455\u0420\u2116
      \u0420\u0456\u0420\xB5\u0420\u0455\u0420\u0458\u0420\xB5\u0421\u201A\u0421\u0402\u0420\u0451\u0420\u0451.
      \u0420\xAD\u0421\u201A\u0420\u0455 \u0420\xB0\u0420\u0406\u0421\u201A\u0420\u0455\u0421\u0402\u0421\u0403\u0420\u0454\u0420\xB0\u0421\u040F
      \u0420\u0454\u0420\u0455\u0420\xBB\u0420\xBB\u0420\u0451\u0420\xB7\u0420\u0451\u0421\u040F,
      \u0420\u0405\u0420\xB5 \u0420\u0406\u0420\u0455\u0421\u0403\u0421\u0403\u0421\u201A\u0420\xB0\u0420\u0405\u0420\u0455\u0420\u0406\u0420\xBB\u0420\xB5\u0420\u0405\u0420\u0405\u0420\xB0\u0421\u040F
      \u0420\u0454\u0420\u0455\u0420\xBB\u0420\xBB\u0420\u0451\u0420\xB7\u0420\u0451\u0421\u040F
      \u0420\u0454\u0420\xB0\u0421\u0402\u0421\u201A\u0421\u2039; \u0420\u0491\u0420\xBB\u0421\u040F
      \u0420\u0458\u0420\u0455\u0420\xB1\u0420\u0451\u0420\xBB\u0421\u040A\u0420\u0405\u0420\u0455\u0420\u2116
      \u0420\u0406\u0420\xB5\u0421\u0402\u0421\u0403\u0420\u0451\u0420\u0451 \u0420\u0458\u0420\u0455\u0420\xB6\u0420\u0405\u0420\u0455
