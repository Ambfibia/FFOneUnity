<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="account-row" class="ff-account-row" picking-mode="Ignore">
        <ui:Button name="saved-account" class="ff-button ff-profile-button ff-account-select" />
        <ui:Button name="edit-account" class="ff-button ff-profile-button ff-account-edit">
            <ui:VisualElement name="icon-pencil" class="ff-profile-icon ff-profile-icon--pencil" picking-mode="Ignore">
                <ui:VisualElement name="stroke" class="ff-profile-icon-stroke ff-pencil-line" picking-mode="Ignore" />
                <ui:VisualElement name="stroke" class="ff-profile-icon-stroke ff-pencil-tip" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
