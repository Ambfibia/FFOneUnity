<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:VisualElement name="mentor-card-window" class="mentor-card-window" picking-mode="Ignore" />
  <ui:VisualElement name="mentor-card-current-art" class="mentor-card-current-art" picking-mode="Ignore" />
  <ui:Label name="mentor-card-current" class="mentor-card-current social-copy social-copy--headline" picking-mode="Ignore" enable-rich-text="false" />
  <ui:Label name="mentor-card-name" class="mentor-card-name social-copy social-copy--headline" picking-mode="Ignore" enable-rich-text="false" />
  <ui:Label name="mentor-card-body" class="mentor-card-body social-copy social-copy--body" picking-mode="Ignore" enable-rich-text="false" />
  <ui:Button name="mentor-card-toggle" class="mentor-card-toggle ff-button mentor-radio" />
</ui:UXML>
