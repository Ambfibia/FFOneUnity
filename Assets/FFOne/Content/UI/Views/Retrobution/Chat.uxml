<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="../../Styles/Retrobution.uss" />
  <Style src="../../Styles/Gameplay.uss" />
  <Style src="../../Styles/GameplayGuide.uss" />
  <Style src="../../Styles/FFTheme.uss" />
  <Style src="../../Styles/GameplaySocial.uss" />
  <ui:Template name="GameplaySocialPanels" src="GameplaySocialPanels.uxml" />
  <ui:Template name="GameplaySocialRows" src="GameplaySocialRows.uxml" />
  <ui:Template name="GameplayMentor" src="GameplayMentor.uxml" />
  <ui:Instance template="GameplaySocialPanels" picking-mode="Ignore" />
  <ui:Instance template="GameplaySocialRows" class="social-row-prototypes" picking-mode="Ignore" />
  <ui:Instance template="GameplayMentor" picking-mode="Ignore" />
  <ui:VisualElement name="chat-root" class="ff-chat-root ff-chat-channel-all retro-screen" picking-mode="Ignore">
    <ui:VisualElement name="chat-window" class="ff-chat-window retro-control" style="left:0px; top:0px; width:440px; height:150px; overflow:visible;">
      <ui:Label class="ff-location-debug" picking-mode="Ignore" />
      <ui:VisualElement name="chat-flow" style="position:absolute; left:0; right:0; top:0; bottom:0; flex-direction:column; overflow:visible;">
        <ui:VisualElement name="chat-tabs" style="height:14px; flex-shrink:0; overflow:visible;">
      <ui:Button name="chat-group" class="ff-chat-group retro-control retro-style-f0263588c5269115" style=" top:1px; width:135px; height:14px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="chat-group-label" class="ff-chat-group-label retro-text" text="GROUP" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="chat-friend" class="ff-chat-friend retro-control retro-style-f0263588c5269115" style=" top:1px; width:135px; height:14px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="chat-friend-label" class="ff-chat-friend-label retro-text" text="FRIEND" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="chat-all" class="ff-chat-all retro-control retro-style-f0263588c5269115" style=" top:1px; width:135px; height:14px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="chat-all-label" class="ff-chat-all-label retro-text" text="ALL" picking-mode="Ignore" /></ui:Button>
          <ui:VisualElement name="chat-active-tab" class="ff-chat-active-tab retro-control retro-style-0bf137ee3a5536b6" picking-mode="Ignore" style=" top:1px; width:135px; height:14px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="chat-active-tab-label" class="ff-chat-active-tab-label retro-text" text="ALL" picking-mode="Ignore" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="chat-history-area" class="ff-chat-history-area retro-style-b85848d434bb271a" style="position:relative; flex-grow:1; min-height:0; overflow:visible;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:ScrollView name="chat-history" class="ff-chat-history" mode="Vertical" style="position:absolute; left:24px; right:0; top:4px; bottom:12px;" /></ui:VisualElement>
        <ui:VisualElement name="chat-entry-row" class="ff-chat-entry-row" style="height:23px; flex-shrink:0; overflow:visible;">
          <ui:VisualElement name="chat-entry-background" class="retro-control retro-style-95164fbd03317c3d" picking-mode="Ignore" style="left:-8px; right:-14px; top:-10px; height:40px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /></ui:VisualElement>
      <ui:Button name="chat-menu" class="retro-control retro-style-fdbbb643ada9247b" style="left:6px; top:0px; width:31px; height:19px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="chat-menu-label" class="retro-text" text="" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="chat-emotes" class="ff-chat-emotes retro-control retro-style-480bf36daec99297" style="left:41px; top:0px; width:31px; height:19px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="chat-emotes-label" class="retro-text" text="" picking-mode="Ignore" /></ui:Button>
          <ui:TextField name="chat-input" class="ff-chat-input" max-length="127" style="position:absolute; left:75px; right:70px; top:-3px; height:23px; margin:0; padding:0;" />
          <ui:VisualElement name="chat-inactive-input" class="ff-chat-inactive-input retro-control retro-style-81196e871fdf947b" picking-mode="Ignore" style="left:40px; right:15px; top:-3px; height:23px; display:none;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="chat-inactive-hint" class="ff-chat-inactive-hint" text="Press ENTER to access chat and menus." picking-mode="Ignore" style="position:absolute; left:10px; top:0; width:100%; height:23px; color:gray; margin:0; padding:0;" /></ui:VisualElement>
          <ui:Button name="chat-send" class="ff-chat-send retro-control retro-style-bb0694c8f5d26b45" style="right:6px; top:-3px; width:69px; height:23px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="chat-send-label" text="SEND" class="retro-text" picking-mode="Ignore" /></ui:Button>
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement class="ff-chat-empty-channel" picking-mode="Ignore">
        <ui:VisualElement class="ff-chat-empty-icon" picking-mode="Ignore" />
        <ui:Label class="ff-chat-empty-text" picking-mode="Ignore" />
      </ui:VisualElement>
      <ui:Button name="chat-resize" class="ff-chat-resize retro-control" style="left:411px; top:18px; width:25px; height:25px;" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
