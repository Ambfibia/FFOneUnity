<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="../../Styles/Retrobution.uss" />
  <ui:VisualElement name="journal-root" class="retro-screen" picking-mode="Ignore">
    <ui:VisualElement name="journal-window" class="retro-control" style="left:0px; top:0px; width:1036px; height:654px; overflow:visible;">
      <ui:VisualElement name="journal-frame" class="retro-control retro-style-f6d42dd9bf39d885" picking-mode="Ignore" style="left:0px; top:0px; width:1036px; height:654px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="journal-frame-label" class="retro-text" text="Mission Journal" picking-mode="Ignore" /></ui:VisualElement>
      <ui:VisualElement name="journal-empty" class="retro-control retro-style-631177e2a516078a" picking-mode="Ignore" style="left:16px; top:30px; width:565px; height:612px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="journal-empty-label" class="retro-text" text="No mission selected" picking-mode="Ignore" /></ui:VisualElement>
      <ui:VisualElement name="journal-details" class="retro-control retro-style-460ed507635b9cdb" style="left:10px; top:10px; width:565px; height:612px; display:none;"><ui:VisualElement class="retro-background" picking-mode="Ignore" />
      <ui:VisualElement name="mission-title" class="retro-control retro-style-99def525269703f0" picking-mode="Ignore" style="left:36px; top:12px; width:317px; height:47px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="mission-title-label" class="retro-text" text="" picking-mode="Ignore" /></ui:VisualElement>
      <ui:VisualElement name="mission-level" class="retro-control retro-style-983b005e25bc9933" picking-mode="Ignore" style="left:36px; top:61px; width:317px; height:15px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="mission-level-label" class="retro-text" text="" picking-mode="Ignore" /></ui:VisualElement>
      <ui:VisualElement name="mission-details-heading" class="retro-control retro-style-983b005e25bc9933" picking-mode="Ignore" style="left:90px; top:145px; width:300px; height:20px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="mission-details-heading-label" class="retro-text" text="MISSION DETAILS:" picking-mode="Ignore" /></ui:VisualElement>
      <ui:VisualElement name="mission-description" class="retro-control retro-style-983b005e25bc9933" picking-mode="Ignore" style="left:50px; top:164px; width:490px; height:100px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="mission-description-label" class="retro-text" text="" picking-mode="Ignore" /></ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement name="journal-active-background" class="retro-control retro-style-fc1ca44c1a6c8c6a" picking-mode="Ignore" style="left:597px; top:11px; width:382px; height:633px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="journal-active-background-label" class="retro-text" text="Active" picking-mode="Ignore" /></ui:VisualElement>
      <ui:VisualElement name="journal-completed-state" picking-mode="Ignore" style="display:none; position:absolute; left:0; top:0; right:0; bottom:0;">
      <ui:VisualElement name="journal-completed-background" class="retro-control retro-style-73645c681d1cec26" picking-mode="Ignore" style="left:597px; top:11px; width:382px; height:633px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="journal-completed-background-label" class="retro-text" text="Completed" picking-mode="Ignore" /></ui:VisualElement>
      </ui:VisualElement>
      <ui:Button name="tab-active" class="retro-control retro-style-d1fc51a1826e43f3" style="left:597px; top:11px; width:100px; height:30px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="tab-active-label" class="retro-text" text="Active" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="tab-completed" class="retro-control retro-style-65fa9f8f0b05b844" style="left:680px; top:11px; width:100px; height:30px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="tab-completed-label" class="retro-text" text="Completed" picking-mode="Ignore" /></ui:Button>
      <ui:ScrollView name="journal-list" mode="Vertical" class="retro-control" style="left:608px; top:51px; width:368px; height:558px;" />
      <ui:Button name="close" class="retro-control retro-style-cc1a3966e5718b57" style="left:996px; top:11px; width:32px; height:32px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="close-label" class="retro-text" text="" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="help" class="retro-control retro-style-18fe4a074da1cc0d" style="left:986px; top:608px; width:30px; height:30px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="help-label" class="retro-text" text="" picking-mode="Ignore" /></ui:Button>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
