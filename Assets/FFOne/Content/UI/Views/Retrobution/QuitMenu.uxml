<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="../../Styles/Retrobution.uss" />
  <ui:VisualElement name="quit-root" class="retro-screen">
    <ui:VisualElement name="quit-backdrop" class="retro-control retro-style-d204b71325c87c84"><ui:VisualElement class="retro-background" picking-mode="Ignore" /></ui:VisualElement>
    <ui:VisualElement name="quit-dialog" class="retro-control retro-style-d3123d38bddc967b" style="width:206px; height:188px; overflow:hidden;">
      <ui:VisualElement class="retro-background" picking-mode="Ignore" />
      <ui:Button name="change-character" class="retro-control retro-style-4c72dc6567a3d1b0" style="left:13px; top:16px; width:175px; height:45px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="change-character-label" class="retro-text" text="CHANGE CHARACTER" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="quit-game" class="retro-control retro-style-4c72dc6567a3d1b0" style="left:13px; top:69px; width:175px; height:45px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="quit-game-label" class="retro-text" text="QUIT GAME" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="cancel" class="retro-control retro-style-2a355f3415cd964d" style="left:13px; top:122px; width:175px; height:45px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="cancel-label" class="retro-text" text="CANCEL" picking-mode="Ignore" /></ui:Button>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
