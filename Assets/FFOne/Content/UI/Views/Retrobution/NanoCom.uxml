<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="../../Styles/Retrobution.uss" />
  <ui:VisualElement name="nanocom-root" class="retro-screen" picking-mode="Ignore">
    <ui:VisualElement name="nanocom-window" class="retro-control" style="left:0px; top:0px; width:174px; height:468px; overflow:visible;">
      <ui:VisualElement name="nanocom-menu-background" class="retro-control" picking-mode="Ignore" style="left:-4px; top:114px; width:178px; height:294px; background-image:url('../../Artwork/Retrobution/25654d51b35f3a92002e55b0.png'); -unity-background-scale-mode:stretch-to-fill;" />
      <ui:VisualElement name="nanocom-menu" class="retro-control" style="left:6px; top:164px; width:158px; height:244px; overflow:hidden;">
      <ui:Button name="inventory" class="retro-control retro-style-4125566f46e18130" style="left:1px; top:21px; width:148px; height:26px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="inventory-label" class="retro-text" text="MY STUFF" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="journal" class="retro-control retro-style-4125566f46e18130" style="left:1px; top:50px; width:148px; height:26px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="journal-label" class="retro-text" text="JOURNAL" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="mail" class="retro-control retro-style-4125566f46e18130" style="left:1px; top:79px; width:148px; height:26px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="mail-label" class="retro-text" text="E-MAIL" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="map" class="retro-control retro-style-4125566f46e18130" style="left:1px; top:108px; width:148px; height:26px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="map-label" class="retro-text" text="MAP" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="settings" class="retro-control retro-style-4125566f46e18130" style="left:1px; top:137px; width:148px; height:26px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="settings-label" class="retro-text" text="SETTINGS" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="guide" class="retro-control retro-style-4125566f46e18130" style="left:1px; top:166px; width:148px; height:26px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="guide-label" class="retro-text" text="GAME GUIDE" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="quit" class="retro-control retro-style-83a71c6e109e2abf" style="left:1px; top:195px; width:148px; height:26px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="quit-label" class="retro-text" text="EXIT GAME" picking-mode="Ignore" /></ui:Button>
      </ui:VisualElement>
      <ui:Button name="close" class="retro-control retro-style-ec7e87a40ea141b5" style="left:162px; top:156px; width:23px; height:23px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="close-label" class="retro-text" text="" picking-mode="Ignore" /></ui:Button>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
