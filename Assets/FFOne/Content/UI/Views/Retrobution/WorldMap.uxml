<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="../../Styles/GameplayTransport.uss" />
  <Style src="../../Styles/FFTheme.uss" />
  <Style src="../../Styles/Retrobution.uss" />
  <Style src="../../Styles/GameplayWorldMap.uss" />
  <ui:Template name="WorldMapFilter" src="WorldMapFilter.uxml" />
  <ui:Template name="WorldMapMarker" src="WorldMapMarker.uxml" />
  <ui:VisualElement name="map-root" class="ff-world-map retro-screen" picking-mode="Ignore">
    <ui:Instance template="WorldMapFilter" class="ff-world-map-filter-template" picking-mode="Ignore" />
    <ui:Instance template="WorldMapMarker" class="ff-world-map-marker-template" picking-mode="Ignore" />
    <ui:VisualElement name="map-window" class="ff-world-map-window retro-control" style="left:0px; top:0px; width:1036px; height:654px; overflow:visible;">
      <ui:VisualElement name="map-window-background" class="retro-control retro-style-1df7e7f7618de56a" picking-mode="Ignore" style="left:0px; top:0px; width:1036px; height:654px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="map-window-background-label" class="retro-text" text="" picking-mode="Ignore" /></ui:VisualElement>
      <ui:VisualElement name="map-viewport" class="ff-world-map-viewport retro-control" style="left:20px; top:14px; width:950px; height:624px; overflow:hidden; background-color:black;">
      <ui:Image name="map-image" scale-mode="StretchToFill" class="ff-world-map-image retro-control" picking-mode="Ignore" style="left:0px; top:0px; width:950px; height:624px;background-image:url('../../Artwork/Retrobution/4e9d57271fc731574b163cf5.png'); " />
      <ui:VisualElement name="map-markers" class="ff-world-map-markers" picking-mode="Ignore" />
      <ui:Image name="map-player" scale-mode="StretchToFill" class="ff-world-map-player ff-world-map-hidden retro-control" picking-mode="Ignore" style="left:0px; top:0px; width:16px; height:16px;background-image:url('../../Artwork/Retrobution/c3f7bbefd4080511a93c9f3f.png'); transform-origin:50% 50%;" />
      <ui:VisualElement name="map-marker-tooltip" class="ff-world-map-tooltip ff-world-map-hidden" picking-mode="Ignore">
        <ui:Label name="map-marker-caption" class="ff-label ff-world-map-tooltip-caption" picking-mode="Ignore" />
      </ui:VisualElement>
      </ui:VisualElement>
      <ui:Image name="map-frame" scale-mode="StretchToFill" class="ff-world-map-frame retro-control" picking-mode="Ignore" style="left:17px; top:10px; width:960px; height:630px;background-image:url('../../Artwork/Retrobution/72a0be452b7ed6d1021efa8c.png'); " />
      <ui:Button name="close" class="ff-world-map-close retro-control retro-style-d2135a60ca4b06ee" style="left:995px; top:13px; width:26px; height:26px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="close-label" class="retro-text" text="" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="help" class="ff-world-map-help retro-control retro-style-8fe9497303999ef5" style="left:995px; top:608px; width:30px; height:30px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="help-label" class="retro-text" text="" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="pan-down" class="ff-world-map-pan-down retro-control retro-style-12130d9a8c44402f" style="left:478px; top:600px; width:40px; height:37px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="pan-down-label" class="retro-text" text="" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="pan-up" class="ff-world-map-pan-up retro-control retro-style-4051fd133de15240" style="left:478px; top:10px; width:40px; height:37px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="pan-up-label" class="retro-text" text="" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="pan-left" class="ff-world-map-pan-left retro-control retro-style-213e8d1d38404cc3" style="left:17px; top:307px; width:37px; height:40px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="pan-left-label" class="retro-text" text="" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="pan-right" class="ff-world-map-pan-right retro-control retro-style-2820541f5c0411bd" style="left:938px; top:307px; width:37px; height:40px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="pan-right-label" class="retro-text" text="" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="zoom-in" class="ff-world-map-zoom-in retro-control retro-style-4fbf7d708265b6c2" style="left:25px; top:60px; width:26px; height:26px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="zoom-in-label" class="retro-text" text="" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="zoom-out" class="ff-world-map-zoom-out retro-control retro-style-7f0925b805b2c3cd" style="left:25px; top:120px; width:26px; height:26px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="zoom-out-label" class="retro-text" text="" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="my-view" class="ff-world-map-my-view retro-control retro-style-51590392c0a97320" style="left:25px; top:18px; width:110px; height:18px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="my-view-label" class="ff-world-map-my-view-label ff-world-map-control-caption retro-text" text="MY VIEW" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="world-view" class="ff-world-map-world-view retro-control retro-style-51590392c0a97320" style="left:25px; top:38px; width:110px; height:18px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="world-view-label" class="ff-world-map-world-view-label ff-world-map-control-caption retro-text" text="WORLD VIEW" picking-mode="Ignore" /></ui:Button>
      <ui:Button name="show-filters" class="ff-world-map-show-filters retro-control retro-style-51590392c0a97320" style="left:857px; top:18px; width:110px; height:18px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="show-filters-label" class="ff-world-map-show-filters-label ff-world-map-control-caption retro-text" text="SHOW FILTERS" picking-mode="Ignore" /></ui:Button>
      <ui:VisualElement name="map-filters" class="ff-world-map-filters" picking-mode="Ignore" />
      <ui:VisualElement name="zoom-bar" class="ff-world-map-zoom-bar retro-control retro-style-1eddef4abcebf136" picking-mode="Ignore" style="left:35px; top:80px; width:8px; height:60px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="zoom-bar-label" class="retro-text" text="" picking-mode="Ignore" /></ui:VisualElement>
      <ui:Button name="zoom-step-0" class="ff-world-map-zoom-step-0 retro-control retro-style-6d1bd4e0c5f92d4a" style="left:28px; top:110px; width:20px; height:7px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="zoom-step-0-label" class="retro-text" text="" picking-mode="Ignore" /></ui:Button>
      <ui:VisualElement name="zoom-step-0-selected" class="ff-world-map-zoom-step-0-selected ff-world-map-hidden" picking-mode="Ignore" style=" position:absolute; left:0; top:0; right:0; bottom:0;">
      <ui:VisualElement name="zoom-selected" class="retro-control retro-style-8e877f7485350448" picking-mode="Ignore" style="left:28px; top:110px; width:20px; height:7px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="zoom-selected-label" class="retro-text" text="" picking-mode="Ignore" /></ui:VisualElement>
      </ui:VisualElement>
      <ui:Button name="zoom-step-1" class="ff-world-map-zoom-step-1 retro-control retro-style-6d1bd4e0c5f92d4a" style="left:28px; top:100px; width:20px; height:7px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="zoom-step-1-label" class="retro-text" text="" picking-mode="Ignore" /></ui:Button>
      <ui:VisualElement name="zoom-step-1-selected" class="ff-world-map-zoom-step-1-selected ff-world-map-hidden" picking-mode="Ignore" style=" position:absolute; left:0; top:0; right:0; bottom:0;">
      <ui:VisualElement name="zoom-selected" class="retro-control retro-style-8e877f7485350448" picking-mode="Ignore" style="left:28px; top:100px; width:20px; height:7px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="zoom-selected-label" class="retro-text" text="" picking-mode="Ignore" /></ui:VisualElement>
      </ui:VisualElement>
      <ui:Button name="zoom-step-2" class="ff-world-map-zoom-step-2 retro-control retro-style-6d1bd4e0c5f92d4a" style="left:28px; top:90px; width:20px; height:7px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="zoom-step-2-label" class="retro-text" text="" picking-mode="Ignore" /></ui:Button>
      <ui:VisualElement name="zoom-step-2-selected" class="ff-world-map-zoom-step-2-selected ff-world-map-hidden" picking-mode="Ignore" style=" position:absolute; left:0; top:0; right:0; bottom:0;">
      <ui:VisualElement name="zoom-selected" class="retro-control retro-style-8e877f7485350448" picking-mode="Ignore" style="left:28px; top:90px; width:20px; height:7px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="zoom-selected-label" class="retro-text" text="" picking-mode="Ignore" /></ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement name="map-location-heading" class="ff-world-map-location-frame retro-control retro-style-abdfff524bceba3f" picking-mode="Ignore"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="map-location-heading-label" class="ff-world-map-location-heading retro-text" text="current location:" picking-mode="Ignore" /></ui:VisualElement>
      <ui:VisualElement name="map-location" class="ff-world-map-location-value retro-control retro-style-53a72b928c8fa946" picking-mode="Ignore"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="map-location-label" class="ff-world-map-location retro-text" picking-mode="Ignore" /></ui:VisualElement>
      <ui:Image name="map-payzone-0" scale-mode="StretchToFill" class="ff-world-map-payzone-0 retro-control" picking-mode="Ignore" style="left:0px; top:0px; width:1px; height:1px;background-image:url('../../Artwork/Retrobution/4e9d57271fc731574b163cf5.png'); display:none;" />
      <ui:Image name="map-payzone-1" scale-mode="StretchToFill" class="ff-world-map-payzone-1 retro-control" picking-mode="Ignore" style="left:0px; top:0px; width:1px; height:1px;background-image:url('../../Artwork/Retrobution/d8e92e524f1fa0431d3f79a9.png'); display:none;" />
      <ui:Image name="map-payzone-2" scale-mode="StretchToFill" class="ff-world-map-payzone-2 retro-control" picking-mode="Ignore" style="left:0px; top:0px; width:1px; height:1px;background-image:url('../../Artwork/Retrobution/0873671bf6a3b9e13010a28c.png'); display:none;" />
      <ui:Image name="map-payzone-3" scale-mode="StretchToFill" class="ff-world-map-payzone-3 retro-control" picking-mode="Ignore" style="left:0px; top:0px; width:1px; height:1px;background-image:url('../../Artwork/Retrobution/6503447bafc3bbe3646e568a.png'); display:none;" />
      <ui:Image name="map-freezone-0" scale-mode="StretchToFill" class="ff-world-map-freezone-0 retro-control" picking-mode="Ignore" style="left:0px; top:0px; width:1px; height:1px;background-image:url('../../Artwork/Retrobution/6c53e57b7123a014f95ce834.png'); display:none;" />
      <ui:Image name="map-freezone-1" scale-mode="StretchToFill" class="ff-world-map-freezone-1 retro-control" picking-mode="Ignore" style="left:0px; top:0px; width:1px; height:1px;background-image:url('../../Artwork/Retrobution/5f49c29fcb2dc4d164ec7c5f.png'); display:none;" />
      <ui:Image name="map-darkzone-0" scale-mode="StretchToFill" class="ff-world-map-darkzone-0 retro-control" picking-mode="Ignore" style="left:0px; top:0px; width:1px; height:1px;background-image:url('../../Artwork/Retrobution/181be3b3b97e7e5d94260c60.png'); display:none;" />
      <ui:Image name="map-darkzone-1" scale-mode="StretchToFill" class="ff-world-map-darkzone-1 retro-control" picking-mode="Ignore" style="left:0px; top:0px; width:1px; height:1px;background-image:url('../../Artwork/Retrobution/537bce79cc9c419b04f58b44.png'); display:none;" />
