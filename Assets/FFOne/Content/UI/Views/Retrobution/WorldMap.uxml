<ui:VisualElement name="transport-root" class="ff-screen transport-root" picking-mode="Ignore">
  <ui:VisualElement name="inventory-backdrop" class="transport-backdrop ff-artwork" picking-mode="Ignore" />
  <ui:VisualElement name="inventory-window" class="transport-window" picking-mode="Ignore">
    <ui:VisualElement class="transport-right ff-artwork" picking-mode="Ignore" />
    <ui:VisualElement class="transport-left ff-artwork" picking-mode="Ignore" />
    <ui:VisualElement class="transport-left-box ff-artwork" picking-mode="Ignore" />
    <ui:Image name="transport-map" class="transport-map" scale-mode="StretchToFill" picking-mode="Ignore" />
    <ui:VisualElement name="transport-markers" class="transport-markers" picking-mode="Ignore" />
    <ui:VisualElement name="transport-scan" class="transport-scan" picking-mode="Ignore">
      <ui:VisualElement class="transport-grid ff-artwork" picking-mode="Ignore" />
      <ui:VisualElement class="transport-scan-large ff-artwork" picking-mode="Ignore" />
      <ui:VisualElement class="transport-scan-small ff-artwork" picking-mode="Ignore" />
    </ui:VisualElement>
    <ui:Label name="transport-title" class="ff-label transport-title" picking-mode="Ignore" />
    <ui:Label name="transport-subtitle" class="ff-label transport-subtitle" picking-mode="Ignore" />
    <ui:Image name="transport-npc" class="transport-npc" picking-mode="Ignore" scale-mode="StretchToFill" />
    <ui:VisualElement class="transport-bubble ff-artwork" picking-mode="Ignore" />
    <ui:Label class="ff-label transport-where" picking-mode="Ignore" />
    <ui:ScrollView name="transport-routes" class="transport-routes" horizontal-scroller-visibility="Hidden" />
    <ui:Button name="transport-close" class="ff-button transport-close" />
    <ui:Button name="transport-go" class="ff-button transport-action transport-go" />
    <ui:Button class="ff-button transport-action transport-register" />
    <ui:VisualElement class="transport-turbo-controls" picking-mode="Ignore">
      <ui:VisualElement class="transport-turbo-background ff-artwork" picking-mode="Ignore" />
      <ui:VisualElement class="transport-turbo-check ff-artwork" picking-mode="Ignore" />
      <ui:Label class="ff-label transport-turbo-title" picking-mode="Ignore" />
      <ui:Button name="transport-turbo" class="ff-button transport-turbo" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:VisualElement>
<ui:Button class="ff-button transport-route-row">
  <ui:VisualElement class="transport-route-selection ff-artwork" picking-mode="Ignore" />
  <ui:VisualElement class="transport-route-icon-back ff-artwork" picking-mode="Ignore" />
  <ui:Image class="transport-route-icon" scale-mode="StretchToFill" picking-mode="Ignore" />
  <ui:Label class="ff-label transport-route-name" picking-mode="Ignore" />
  <ui:Label class="ff-label transport-route-region" picking-mode="Ignore" />
  <ui:VisualElement class="transport-route-taros ff-artwork" picking-mode="Ignore" />
  <ui:Label class="ff-label transport-route-fare" picking-mode="Ignore" />
</ui:Button>
<ui:Image class="transport-marker" scale-mode="StretchToFill" picking-mode="Ignore" />
</ui:UXML>
