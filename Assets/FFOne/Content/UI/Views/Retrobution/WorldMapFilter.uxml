<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Button class="ff-button ff-world-map-filter">
    <ui:VisualElement name="filter-glow" class="ff-world-map-filter-glow" picking-mode="Ignore" />
    <ui:Image name="filter-icon" class="ff-world-map-filter-icon" picking-mode="Ignore" scale-mode="StretchToFill" />
    <ui:VisualElement name="filter-arrow" class="ff-world-map-filter-arrow" picking-mode="Ignore" />
  </ui:Button>
</ui:UXML>
