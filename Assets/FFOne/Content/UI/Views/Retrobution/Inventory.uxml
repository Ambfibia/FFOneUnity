<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="../../Styles/Retrobution.uss" />
  <Style src="../../Styles/FFTheme.uss" />
  <Style src="../../Styles/GameplayMail.uss" />
  <Style src="../../Styles/GameplayInventory.uss" />
  <Style src="../../Styles/GameplayCroc.uss" />
  <ui:Template name="InventoryItemSlot" src="InventoryItemSlot.uxml" />
  <ui:Template name="InventoryNanoCard" src="InventoryNanoCard.uxml" />
  <ui:Template name="CrocWorkshop" src="CrocWorkshop.uxml" />
  <ui:VisualElement name="inventory-root" class="retro-screen inventory-screen" picking-mode="Ignore">
    <ui:VisualElement name="inventory-backdrop" class="ff-artwork inventory-backdrop" picking-mode="Ignore" />
    <ui:VisualElement name="inventory-window" class="retro-control inventory-window">
      <ui:VisualElement name="inventory-background" class="retro-control inventory-background" picking-mode="Ignore"></ui:VisualElement>
      <ui:VisualElement name="inventory-character-background" class="retro-control inventory-character-background" picking-mode="Ignore"></ui:VisualElement>
      <ui:VisualElement name="inventory-character" class="retro-control inventory-character" picking-mode="Ignore">
        <ui:Image name="inventory-avatar" class="retro-control inventory-avatar" scale-mode="StretchToFill" picking-mode="Ignore" />
        <ui:VisualElement name="inventory-combat-stat-0" class="ff-artwork inventory-combat-stat-0" picking-mode="Ignore" />
        <ui:Label name="inventory-combat-value-0" class="inventory-copy ff-label retro-control inventory-combat-value-0" picking-mode="Ignore" enable-rich-text="false" text="—" />
        <ui:VisualElement name="inventory-combat-stat-1" class="ff-artwork inventory-combat-stat-1" picking-mode="Ignore" />
        <ui:Label name="inventory-combat-value-1" class="inventory-copy ff-label retro-control inventory-combat-value-1" picking-mode="Ignore" enable-rich-text="false" text="—" />
        <ui:VisualElement name="inventory-combat-stat-2" class="ff-artwork inventory-combat-stat-2" picking-mode="Ignore" />
        <ui:Label name="inventory-combat-value-2" class="inventory-copy ff-label retro-control inventory-combat-value-2" picking-mode="Ignore" enable-rich-text="false" text="—" />
        <ui:Instance template="InventoryNanoCard" name="inventory-nano-card-0" class="retro-control inventory-nano-card inventory-nano-card-0" picking-mode="Ignore" />
        <ui:Instance template="InventoryNanoCard" name="inventory-nano-card-1" class="retro-control inventory-nano-card inventory-nano-card-1" picking-mode="Ignore" />
        <ui:Instance template="InventoryNanoCard" name="inventory-nano-card-2" class="retro-control inventory-nano-card inventory-nano-card-2" picking-mode="Ignore" />
        <ui:Image name="inventory-nano-portrait-0" class="retro-control inventory-nano-portrait-0" scale-mode="StretchToFill" picking-mode="Ignore" />
        <ui:Image name="inventory-nano-portrait-1" class="retro-control inventory-nano-portrait-1" scale-mode="StretchToFill" picking-mode="Ignore" />
        <ui:Image name="inventory-nano-portrait-2" class="retro-control inventory-nano-portrait-2" scale-mode="StretchToFill" picking-mode="Ignore" />
        <ui:VisualElement name="inventory-vehicle-back" class="ff-artwork inventory-vehicle-back" picking-mode="Ignore" />
        <ui:Label name="inventory-vehicle-heading" class="inventory-copy ff-label retro-control inventory-vehicle-heading" picking-mode="Ignore" enable-rich-text="false" />
        <ui:Label name="inventory-vehicle-name" class="inventory-copy ff-label retro-control inventory-vehicle-name" picking-mode="Ignore" enable-rich-text="false" />
        <ui:VisualElement name="inventory-status" class="retro-control inventory-status" picking-mode="Ignore">
          <ui:Label name="inventory-player-name" class="inventory-copy ff-label retro-control inventory-player-name" picking-mode="Ignore" enable-rich-text="false" />
          <ui:Label name="inventory-player-level" class="inventory-copy ff-label retro-control inventory-player-level" picking-mode="Ignore" enable-rich-text="false" />
          <ui:VisualElement name="inventory-guide-box" class="ff-artwork inventory-guide-box" picking-mode="Ignore" />
          <ui:Label name="inventory-guide-heading" class="inventory-copy ff-label retro-control inventory-guide-heading" picking-mode="Ignore" enable-rich-text="false" />
          <ui:Label name="inventory-guide-name" class="inventory-copy ff-label retro-control inventory-guide-name" picking-mode="Ignore" enable-rich-text="false" />
          <ui:Image name="inventory-guide-icon" class="retro-control inventory-guide-icon" scale-mode="StretchToFill" picking-mode="Ignore" />
          <ui:VisualElement name="inventory-health-back" class="ff-artwork inventory-health-back" picking-mode="Ignore" />
          <ui:VisualElement name="inventory-health-fill" class="ff-artwork inventory-health-fill" picking-mode="Ignore" />
          <ui:VisualElement name="inventory-fusion-back" class="ff-artwork inventory-fusion-back" picking-mode="Ignore" />
          <ui:VisualElement name="inventory-fusion-fill" class="ff-artwork inventory-fusion-fill" picking-mode="Ignore" />
          <ui:Label name="inventory-health-caption" class="inventory-copy ff-label retro-control inventory-health-caption" picking-mode="Ignore" enable-rich-text="false" />
          <ui:Label name="inventory-fusion-caption" class="inventory-copy ff-label retro-control inventory-fusion-caption" picking-mode="Ignore" enable-rich-text="false" />
          <ui:Label name="inventory-health-value" class="inventory-copy ff-label retro-control inventory-health-value" picking-mode="Ignore" enable-rich-text="false" />
          <ui:Label name="inventory-fusion-value" class="inventory-copy ff-label retro-control inventory-fusion-value" picking-mode="Ignore" enable-rich-text="false" />
        </ui:VisualElement>
        <ui:Button name="inventory-turn-left" class="retro-control ff-button inventory-turn-left" />
        <ui:Button name="inventory-turn-right" class="retro-control ff-button inventory-turn-right" />
      </ui:VisualElement>
      <ui:VisualElement name="inventory-stuff" class="retro-control inventory-stuff">
        <ui:VisualElement name="inventory-inactive-equipment" class="ff-artwork inventory-inactive-equipment" picking-mode="Ignore" />
        <ui:VisualElement name="inventory-inactive-nanos" class="ff-artwork inventory-inactive-nanos" picking-mode="Ignore" />
        <ui:VisualElement name="inventory-frame" class="retro-control inventory-frame" picking-mode="Ignore"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="inventory-frame-label" class="retro-text" text="" picking-mode="Ignore" /></ui:VisualElement>
        <ui:Button name="tab-equipment" class="retro-control inventory-tab inventory-equipment-tab"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="tab-equipment-label" class="retro-text inventory-equipment-caption" text="EQUIPMENT" picking-mode="Ignore" /></ui:Button>
        <ui:Button name="tab-nanos" class="retro-control inventory-tab inventory-nanos-tab"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="tab-nanos-label" class="retro-text inventory-nanos-caption" text="NANOS" picking-mode="Ignore" /></ui:Button>
        <ui:ScrollView name="inventory-grid" class="retro-control inventory-grid" horizontal-scroller-visibility="Hidden">
          <ui:VisualElement name="inventory-slots" class="inventory-slots" />
        </ui:ScrollView>
        <ui:ScrollView name="nano-inventory-grid" class="retro-control nano-inventory-grid" horizontal-scroller-visibility="Hidden">
          <ui:VisualElement name="nano-inventory-slots" class="nano-inventory-slots" />
        </ui:ScrollView>
        <ui:Button name="close" class="retro-control retro-style-8c59bd48388d3b39 inventory-close"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="close-label" class="retro-text" text="" picking-mode="Ignore" /></ui:Button>
        <ui:Button name="trash" class="retro-control retro-style-cd3897e5dac4c7de inventory-trash"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="trash-label" class="retro-text" text="" picking-mode="Ignore" /></ui:Button>
        <ui:Button name="help" class="retro-control retro-style-c5d87768a7d24450 inventory-help"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="help-label" class="retro-text" text="" picking-mode="Ignore" /></ui:Button>
        <ui:Button name="hammer" class="retro-control retro-style-fdc39f9d0d73d674 inventory-hammer"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="hammer-label" class="retro-text" text="" picking-mode="Ignore" /></ui:Button>
        <ui:VisualElement name="inventory-grid-shadow" class="ff-artwork inventory-grid-shadow" picking-mode="Ignore" />
        <ui:VisualElement name="inventory-taros-art" class="ff-artwork inventory-taros-art" picking-mode="Ignore" />
        <ui:Label name="inventory-taros" class="inventory-copy ff-label retro-control inventory-taros" picking-mode="Ignore" enable-rich-text="false" />
        <ui:Label name="inventory-taros-digit-0" class="inventory-copy ff-label retro-control inventory-taros-digit-0" picking-mode="Ignore" enable-rich-text="false" text="0" />
        <ui:Label name="inventory-taros-digit-1" class="inventory-copy ff-label retro-control inventory-taros-digit-1" picking-mode="Ignore" enable-rich-text="false" text="0" />
        <ui:Label name="inventory-taros-digit-2" class="inventory-copy ff-label retro-control inventory-taros-digit-2" picking-mode="Ignore" enable-rich-text="false" text="0" />
        <ui:Label name="inventory-taros-digit-3" class="inventory-copy ff-label retro-control inventory-taros-digit-3" picking-mode="Ignore" enable-rich-text="false" text="0" />
        <ui:Label name="inventory-taros-digit-4" class="inventory-copy ff-label retro-control inventory-taros-digit-4" picking-mode="Ignore" enable-rich-text="false" text="0" />
        <ui:Label name="inventory-taros-digit-5" class="inventory-copy ff-label retro-control inventory-taros-digit-5" picking-mode="Ignore" enable-rich-text="false" text="0" />
        <ui:Label name="inventory-taros-digit-6" class="inventory-copy ff-label retro-control inventory-taros-digit-6" picking-mode="Ignore" enable-rich-text="false" text="0" />
        <ui:Label name="inventory-taros-digit-7" class="inventory-copy ff-label retro-control inventory-taros-digit-7" picking-mode="Ignore" enable-rich-text="false" text="0" />
        <ui:Label name="inventory-taros-digit-8" class="inventory-copy ff-label retro-control inventory-taros-digit-8" picking-mode="Ignore" enable-rich-text="false" text="0" />
        <ui:VisualElement name="inventory-dexlabs" class="ff-artwork inventory-dexlabs" picking-mode="Ignore" />
        <ui:Button name="inventory-redeem" class="retro-control ff-button inventory-redeem" />
      </ui:VisualElement>
      <ui:VisualElement name="equipment-panel" class="retro-control equipment-panel">
        <ui:VisualElement name="equipment-title" class="retro-control retro-style-7b2bb77fe40573af equipment-title" picking-mode="Ignore"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="equipment-title-label" class="retro-text equipment-title-caption" text="Equipped" picking-mode="Ignore" /></ui:VisualElement>
        <ui:VisualElement name="boost-back" class="ff-artwork boost-back" picking-mode="Ignore" />
        <ui:VisualElement name="boost-icon" class="ff-artwork boost-icon" picking-mode="Ignore" />
        <ui:Label name="boost-caption" class="inventory-copy ff-label retro-control boost-caption" picking-mode="Ignore" enable-rich-text="false" />
        <ui:Label name="boost-count" class="inventory-copy ff-label retro-control boost-count" picking-mode="Ignore" enable-rich-text="false" />
        <ui:VisualElement name="potion-back" class="ff-artwork potion-back" picking-mode="Ignore" />
        <ui:VisualElement name="potion-icon" class="ff-artwork potion-icon" picking-mode="Ignore" />
        <ui:Label name="potion-caption" class="inventory-copy ff-label retro-control potion-caption" picking-mode="Ignore" enable-rich-text="false" />
        <ui:Label name="potion-count" class="inventory-copy ff-label retro-control potion-count" picking-mode="Ignore" enable-rich-text="false" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement class="inventory-item-detail" picking-mode="Position">
      <ui:VisualElement class="inventory-detail-window">
        <ui:VisualElement class="inventory-detail-art" picking-mode="Ignore" />
        <ui:Image class="inventory-detail-icon" picking-mode="Ignore" />
        <ui:Label class="inventory-detail-title" picking-mode="Ignore" enable-rich-text="false" />
        <ui:Label class="inventory-detail-level" picking-mode="Ignore" />
        <ui:VisualElement class="inventory-detail-ratings">
          <ui:VisualElement class="inventory-detail-column"><ui:Label class="inventory-rating-point-caption" /><ui:Label class="inventory-rating-point" /></ui:VisualElement>
          <ui:VisualElement class="inventory-detail-column"><ui:Label class="inventory-rating-group-caption" /><ui:Label class="inventory-rating-group" /></ui:VisualElement>
          <ui:VisualElement class="inventory-detail-column"><ui:Label class="inventory-rating-defense-caption" /><ui:Label class="inventory-rating-defense" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:ScrollView class="inventory-detail-description-box" horizontal-scroller-visibility="Hidden"><ui:Label class="inventory-detail-description" enable-rich-text="false" /></ui:ScrollView>
        <ui:Button class="ff-button inventory-detail-action" />
        <ui:Button class="inventory-detail-close" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:Instance template="InventoryItemSlot" name="inventory-slot-template" class="inventory-slot-template" picking-mode="Ignore" />
    <ui:Instance template="CrocWorkshop" name="croc-workshop-template" class="croc-workshop-template" picking-mode="Ignore" />
  </ui:VisualElement>
  <ui:VisualElement class="ff-cashmall-list-skin" picking-mode="Ignore">
    <ui:VisualElement class="ff-artwork ff-cashmall-list-back" picking-mode="Ignore" />
    <ui:VisualElement class="ff-artwork ff-cashmall-scroll-shadow" picking-mode="Ignore" />
  </ui:VisualElement>
  <ui:VisualElement class="mail-layout-template" picking-mode="Ignore">
    <ui:VisualElement name="mail-content" class="mail-content" picking-mode="Ignore">
      <ui:Button name="mail-compose" class="mail-compose ff-button mail-action" />
      <ui:Button name="mail-refresh" class="mail-refresh ff-button mail-action" />
      <ui:VisualElement name="mail-inner" class="mail-inner" picking-mode="Ignore">
        <ui:VisualElement name="mail-table" class="mail-table" picking-mode="Ignore">
          <ui:VisualElement name="mail-tab-fill" class="mail-tab-fill" picking-mode="Ignore" />
          <ui:Button name="mail-guide-tab" class="mail-guide-tab ff-button mail-folder-tab" />
          <ui:Button name="mail-player-tab" class="mail-player-tab ff-button mail-folder-tab" />
          <ui:VisualElement name="mail-table-art" class="mail-table-art" picking-mode="Ignore" />
          <ui:Label name="mail-heading-from" class="mail-heading-from mail-copy" picking-mode="Ignore" enable-rich-text="false" />
          <ui:Label name="mail-heading-subject" class="mail-heading-subject mail-copy" picking-mode="Ignore" enable-rich-text="false" />
          <ui:Label name="mail-heading-day" class="mail-heading-day mail-copy" picking-mode="Ignore" enable-rich-text="false" />
          <ui:VisualElement name="mail-heading-attachment" class="mail-heading-attachment" picking-mode="Ignore" />
          <ui:ScrollView name="mail-list" class="mail-list" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
          <ui:Label name="mail-empty-folder" class="mail-empty-folder mail-copy mail-copy--body" picking-mode="Ignore" enable-rich-text="false" />
          <ui:Button name="mail-previous" class="mail-previous ff-button mail-page-action" />
          <ui:Button name="mail-next" class="mail-next ff-button mail-page-action" />
          <ui:Label name="mail-page" class="mail-page mail-copy mail-copy--body" picking-mode="Ignore" enable-rich-text="false" />
        </ui:VisualElement>
        <ui:VisualElement name="mail-detail" class="mail-inbox-detail" picking-mode="Ignore">
          <ui:Label name="mail-no-selection" class="mail-no-selection mail-copy mail-copy--body" picking-mode="Ignore" enable-rich-text="false" />
          <ui:VisualElement name="mail-message" class="mail-message" picking-mode="Ignore">
            <ui:Label name="mail-from-caption" class="mail-from-caption mail-copy" picking-mode="Ignore" enable-rich-text="false" />
            <ui:Label name="mail-subject-caption" class="mail-subject-caption mail-copy" picking-mode="Ignore" enable-rich-text="false" />
            <ui:Label name="mail-detail-from" class="mail-detail-from mail-copy mail-copy--body" picking-mode="Ignore" enable-rich-text="false" />
            <ui:Label name="mail-detail-subject" class="mail-detail-subject mail-copy mail-copy--body" picking-mode="Ignore" enable-rich-text="false" />
            <ui:Image name="mail-sender-portrait" class="mail-sender-portrait" picking-mode="Ignore" scale-mode="StretchToFill" />
            <ui:VisualElement name="mail-paper-art" class="mail-paper-art" picking-mode="Ignore" />
            <ui:ScrollView name="mail-read-body" class="mail-read-body" horizontal-scroller-visibility="Hidden">
              <ui:Label name="mail-detail-body" class="mail-detail-body mail-copy mail-copy--body" picking-mode="Ignore" enable-rich-text="false" />
            </ui:ScrollView>
            <ui:VisualElement name="mail-attachments" class="mail-attachments" picking-mode="Ignore" />
            <ui:VisualElement name="mail-claims" class="mail-claims" picking-mode="Ignore">
              <ui:Button name="mail-take-all" class="mail-take-all ff-button mail-action" />
              <ui:Button name="mail-take-taros" class="mail-take-taros ff-button mail-action" />
            </ui:VisualElement>
          </ui:VisualElement>
          <ui:Label name="mail-guide-note" class="mail-guide-note mail-copy mail-copy--body" picking-mode="Ignore" enable-rich-text="false" />
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement class="mail-form-template mail-form-surface" picking-mode="Ignore">
        <ui:TextField name="mail-recipient" class="mail-recipient mail-field" max-length="20" />
        <ui:DropdownField name="mail-friend" class="mail-friend mail-field" />
        <ui:TextField name="mail-subject" class="mail-subject mail-field" max-length="31" />
        <ui:TextField name="mail-body" class="mail-body mail-field mail-field--paper" max-length="511" multiline="true" />
        <ui:TextField name="mail-taros" class="mail-taros mail-field" max-length="10" value="0" />
        <ui:Label name="mail-cost" class="mail-cost mail-copy mail-copy--body" picking-mode="Ignore" enable-rich-text="false" />
        <ui:ScrollView name="mail-compose-items" class="mail-compose-items" horizontal-scroller-visibility="Hidden" />
        <ui:Button name="mail-send" class="mail-send ff-button mail-action" />
        <ui:Button name="mail-clear-items" class="mail-clear-items ff-button mail-action" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:Label name="mail-status" class="mail-status mail-copy mail-copy--body" picking-mode="Ignore" enable-rich-text="false" />
  </ui:VisualElement>
  <ui:Button name="mail-delete" class="mail-delete ff-button mail-trash" />
  <ui:Button class="mail-row-template ff-button mail-row-item">
    <ui:VisualElement name="mail-row-selection" class="mail-row-selection" picking-mode="Ignore" />
    <ui:Label name="mail-row-from" class="mail-row-from mail-copy mail-copy--body" picking-mode="Ignore" enable-rich-text="false" />
    <ui:Label name="mail-row-subject" class="mail-row-subject mail-copy mail-copy--body" picking-mode="Ignore" enable-rich-text="false" />
    <ui:VisualElement name="mail-row-attachment" class="mail-row-attachment" picking-mode="Ignore" />
  </ui:Button>
  <ui:Button class="mail-attach-template ff-button mail-action" />
  <ui:Button class="mail-compose-item-template ff-button mail-copy--body" />
  <ui:VisualElement class="ff-bank-search">
    <ui:Label class="ff-bank-tab" picking-mode="Ignore" />
    <ui:TextField class="ff-bank-query" />
  </ui:VisualElement>
</ui:UXML>
