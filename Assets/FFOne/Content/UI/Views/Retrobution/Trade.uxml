<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="../../Styles/Retrobution.uss" />
  <ui:VisualElement name="trade-root" class="retro-screen" picking-mode="Ignore">
    <ui:VisualElement name="trade-window" class="retro-control" style="left:0px; top:0px; width:550px; height:700px; overflow:visible;">
      <ui:VisualElement name="trade-background" class="retro-control retro-style-4bbb52b784f94893" picking-mode="Ignore" style="left:12px; top:29px; width:480px; height:448px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="trade-background-label" class="retro-text" text="" picking-mode="Ignore" /></ui:VisualElement>
      <ui:VisualElement name="trade-own" class="retro-control retro-style-2909dec5e0d1e9d7" style="left:25px; top:35px; width:480px; height:157px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" />
      <ui:Button name="trade-own-slot-0" class="retro-control retro-style-63248d0ae245f8ca" style="left:51px; top:36px; width:62px; height:62px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Image name="trade-own-slot-0-image" picking-mode="Ignore" style="position:absolute; left:0; top:0; right:0; bottom:0;" /><ui:Label name="trade-own-slot-0-count" picking-mode="Ignore" style="position:absolute; right:3px; bottom:2px; color:white;" /></ui:Button>
      <ui:Button name="trade-own-slot-1" class="retro-control retro-style-63248d0ae245f8ca" style="left:118px; top:36px; width:62px; height:62px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Image name="trade-own-slot-1-image" picking-mode="Ignore" style="position:absolute; left:0; top:0; right:0; bottom:0;" /><ui:Label name="trade-own-slot-1-count" picking-mode="Ignore" style="position:absolute; right:3px; bottom:2px; color:white;" /></ui:Button>
      <ui:Button name="trade-own-slot-2" class="retro-control retro-style-63248d0ae245f8ca" style="left:185px; top:36px; width:62px; height:62px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Image name="trade-own-slot-2-image" picking-mode="Ignore" style="position:absolute; left:0; top:0; right:0; bottom:0;" /><ui:Label name="trade-own-slot-2-count" picking-mode="Ignore" style="position:absolute; right:3px; bottom:2px; color:white;" /></ui:Button>
      <ui:Button name="trade-own-slot-3" class="retro-control retro-style-63248d0ae245f8ca" style="left:252px; top:36px; width:62px; height:62px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Image name="trade-own-slot-3-image" picking-mode="Ignore" style="position:absolute; left:0; top:0; right:0; bottom:0;" /><ui:Label name="trade-own-slot-3-count" picking-mode="Ignore" style="position:absolute; right:3px; bottom:2px; color:white;" /></ui:Button>
      <ui:Button name="trade-own-slot-4" class="retro-control retro-style-63248d0ae245f8ca" style="left:319px; top:36px; width:62px; height:62px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Image name="trade-own-slot-4-image" picking-mode="Ignore" style="position:absolute; left:0; top:0; right:0; bottom:0;" /><ui:Label name="trade-own-slot-4-count" picking-mode="Ignore" style="position:absolute; right:3px; bottom:2px; color:white;" /></ui:Button>
      <ui:VisualElement name="trade-own-taros" class="retro-control retro-style-a8b6c37b3d65b77f" picking-mode="Ignore" style="left:50px; top:104px; width:150px; height:28px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="trade-own-taros-label" class="retro-text" text="0" picking-mode="Ignore" /></ui:VisualElement>
      <ui:VisualElement name="trade-own-name" class="retro-control retro-style-f1e2171e2426e00e" picking-mode="Ignore" style="left:50px; top:20px; width:320px; height:20px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="trade-own-name-label" class="retro-text" text="MY OFFER" picking-mode="Ignore" /></ui:VisualElement>
        <ui:Image name="trade-own-portrait" scale-mode="StretchToFill" style="position:absolute; left:400px; top:20px; width:70px; height:70px;" picking-mode="Ignore" />
      <ui:Button name="trade-add-taros" class="retro-control retro-style-08d1243537d25304" style="left:247px; top:107px; width:132px; height:25px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="trade-add-taros-label" class="retro-text" text="ADD TAROS" picking-mode="Ignore" /></ui:Button>
      </ui:VisualElement>
      <ui:VisualElement name="trade-other" class="retro-control retro-style-948b0023ddb37385" style="left:0px; top:200px; width:480px; height:172px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" />
      <ui:Button name="trade-other-slot-0" class="retro-control retro-style-63248d0ae245f8ca" style="left:118px; top:37px; width:62px; height:62px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Image name="trade-other-slot-0-image" picking-mode="Ignore" style="position:absolute; left:0; top:0; right:0; bottom:0;" /><ui:Label name="trade-other-slot-0-count" picking-mode="Ignore" style="position:absolute; right:3px; bottom:2px; color:white;" /></ui:Button>
      <ui:Button name="trade-other-slot-1" class="retro-control retro-style-63248d0ae245f8ca" style="left:185px; top:37px; width:62px; height:62px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Image name="trade-other-slot-1-image" picking-mode="Ignore" style="position:absolute; left:0; top:0; right:0; bottom:0;" /><ui:Label name="trade-other-slot-1-count" picking-mode="Ignore" style="position:absolute; right:3px; bottom:2px; color:white;" /></ui:Button>
      <ui:Button name="trade-other-slot-2" class="retro-control retro-style-63248d0ae245f8ca" style="left:252px; top:37px; width:62px; height:62px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Image name="trade-other-slot-2-image" picking-mode="Ignore" style="position:absolute; left:0; top:0; right:0; bottom:0;" /><ui:Label name="trade-other-slot-2-count" picking-mode="Ignore" style="position:absolute; right:3px; bottom:2px; color:white;" /></ui:Button>
      <ui:Button name="trade-other-slot-3" class="retro-control retro-style-63248d0ae245f8ca" style="left:319px; top:37px; width:62px; height:62px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Image name="trade-other-slot-3-image" picking-mode="Ignore" style="position:absolute; left:0; top:0; right:0; bottom:0;" /><ui:Label name="trade-other-slot-3-count" picking-mode="Ignore" style="position:absolute; right:3px; bottom:2px; color:white;" /></ui:Button>
      <ui:Button name="trade-other-slot-4" class="retro-control retro-style-63248d0ae245f8ca" style="left:386px; top:37px; width:62px; height:62px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Image name="trade-other-slot-4-image" picking-mode="Ignore" style="position:absolute; left:0; top:0; right:0; bottom:0;" /><ui:Label name="trade-other-slot-4-count" picking-mode="Ignore" style="position:absolute; right:3px; bottom:2px; color:white;" /></ui:Button>
      <ui:VisualElement name="trade-other-taros" class="retro-control retro-style-a8b6c37b3d65b77f" picking-mode="Ignore" style="left:116px; top:106px; width:290px; height:28px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="trade-other-taros-label" class="retro-text" text="0" picking-mode="Ignore" /></ui:VisualElement>
      <ui:VisualElement name="trade-other-name" class="retro-control retro-style-f1e2171e2426e00e" picking-mode="Ignore" style="left:110px; top:15px; width:330px; height:20px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="trade-other-name-label" class="retro-text" text="" picking-mode="Ignore" /></ui:VisualElement>
        <ui:Image name="trade-other-portrait" scale-mode="StretchToFill" style="position:absolute; left:35px; top:12px; width:70px; height:70px;" picking-mode="Ignore" />
      </ui:VisualElement>
      <ui:Button name="trade-submit" class="retro-control retro-style-08d1243537d25304" style="left:340px; top:432px; width:133px; height:30px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="trade-submit-label" class="retro-text" text="SUBMIT" picking-mode="Ignore" /></ui:Button>
      <ui:VisualElement name="trade-status-name" class="retro-control retro-style-f1e2171e2426e00e" picking-mode="Ignore" style="left:32px; top:380px; width:440px; height:20px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="trade-status-name-label" class="retro-text" text="" picking-mode="Ignore" /></ui:VisualElement>
      <ui:VisualElement name="trade-status-detail" class="retro-control retro-style-f1e2171e2426e00e" picking-mode="Ignore" style="left:32px; top:395px; width:440px; height:20px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="trade-status-detail-label" class="retro-text" text="" picking-mode="Ignore" /></ui:VisualElement>
      <ui:VisualElement name="trade-chat" class="retro-control retro-style-a1c04f70b0fe9af0" style="left:10px; top:490px; width:483px; height:141px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" />
        <ui:ScrollView name="trade-chat-history" mode="Vertical" class="retro-control" style="left:12px; top:49px; width:458px; height:49px;" />
        <ui:TextField name="trade-chat-input" max-length="64" class="retro-control" style="left:18px; top:104px; width:400px; height:25px;" />
      <ui:Button name="trade-chat-send" class="retro-control retro-style-08d1243537d25304" style="left:415px; top:105px; width:57px; height:24px;"><ui:VisualElement class="retro-background" picking-mode="Ignore" /><ui:Label name="trade-chat-send-label" class="retro-text" text="SEND" picking-mode="Ignore" /></ui:Button>
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
