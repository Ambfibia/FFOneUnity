<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:VisualElement name="gameplay-buffs" class="gameplay-buffs" picking-mode="Ignore" />
  <ui:ScrollView name="gameplay-detectors" class="gameplay-detectors ui-suppressed" picking-mode="Ignore">
    <ui:Label class="gameplay-detector-copy" enable-rich-text="false" />
  </ui:ScrollView>
  <ui:VisualElement class="gameplay-buff-cell" picking-mode="Ignore">
    <ui:Image class="gameplay-buff-icon" scale-mode="ScaleToFit" />
    <ui:Label class="gameplay-buff-timer" enable-rich-text="false" />
  </ui:VisualElement>
</ui:UXML>
