<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Styles/FFTheme.uss" />
    <Style src="../Styles/CharacterSelection.uss" />
    <ui:Template name="RosterSlot" src="RosterSlot.uxml" />
    <ui:VisualElement name="character-selection" class="ff-screen roster-character-selection" picking-mode="Ignore">
        <ui:Image scale-mode="StretchToFill" name="selection-background-0" class="ff-artwork roster-background roster-background-0" style="left:0px; top:0px; width:542px; height:477px;" picking-mode="Ignore" />
        <ui:Image scale-mode="StretchToFill" name="selection-background-1" class="ff-artwork roster-background roster-background-1" style="left:542px; top:0px; width:542px; height:477px;" picking-mode="Ignore" />
        <ui:Image scale-mode="StretchToFill" name="selection-background-2" class="ff-artwork roster-background roster-background-2" style="left:1084px; top:0px; width:542px; height:477px;" picking-mode="Ignore" />
        <ui:Image scale-mode="StretchToFill" name="selection-background-3" class="ff-artwork roster-background roster-background-3" style="left:1626px; top:0px; width:542px; height:477px;" picking-mode="Ignore" />
        <ui:Image scale-mode="StretchToFill" name="selection-background-4" class="ff-artwork roster-background roster-background-4" style="left:2168px; top:0px; width:542px; height:477px;" picking-mode="Ignore" />
        <ui:Image scale-mode="StretchToFill" name="selection-background-5" class="ff-artwork roster-background roster-background-5" style="left:2710px; top:0px; width:542px; height:477px;" picking-mode="Ignore" />
        <ui:Image scale-mode="StretchToFill" name="selection-background-6" class="ff-artwork roster-background roster-background-6" style="left:3252px; top:0px; width:542px; height:477px;" picking-mode="Ignore" />
        <ui:Image scale-mode="StretchToFill" name="selection-background-7" class="ff-artwork roster-background roster-background-7" style="left:3794px; top:0px; width:542px; height:477px;" picking-mode="Ignore" />
        <ui:Image scale-mode="StretchToFill" name="selection-background-8" class="ff-artwork roster-background roster-background-8" style="left:4336px; top:0px; width:542px; height:477px;" picking-mode="Ignore" />
        <ui:Image scale-mode="StretchToFill" name="selection-background-9" class="ff-artwork roster-background roster-background-9" style="left:4878px; top:0px; width:542px; height:477px;" picking-mode="Ignore" />
        <ui:VisualElement name="selection-chrome" class="ff-artwork roster-selection-chrome" style="left:0px; top:0px; width:1920px; height:1440px;" picking-mode="Ignore" />
        <ui:VisualElement name="avatar-group" class="roster-avatar-group" picking-mode="Ignore">
            <ui:Image scale-mode="StretchToFill" name="selected-avatar-preview" class="ff-artwork selection-avatar-preview roster-selected-avatar-preview" style="left:0px; top:0px; width:550px; height:583px;" picking-mode="Ignore" />
            <ui:Label name="selected-avatar-status" class="ff-label ff-label--chalet selection-preview-status roster-selected-avatar-status" style="left:100px; top:245px; width:350px; height:64px;" picking-mode="Ignore" />
            <ui:Label name="selected-avatar-name" class="ff-label ff-label--chalet selection-padded roster-selected-avatar-name" style="left:0px; top:23px; width:550px; height:15px;" picking-mode="Ignore" />
            <ui:Button name="rotate-left" class="ff-button roster-rotate-left" style="left:50px; top:480px; width:66px; height:110px;"  />
            <ui:Button name="rotate-right" class="ff-button roster-rotate-right" style="left:440px; top:480px; width:66px; height:110px;"  />
        </ui:VisualElement>
        <ui:VisualElement name="selection-group" class="roster-selection-group" picking-mode="Ignore">
            <ui:Label name="selection-title" class="ff-label selection-padded roster-selection-title" style="left:134px; top:2px; width:217px; height:25px;" picking-mode="Ignore" />
            <ui:Instance template="RosterSlot" name="roster-slot-1" class="selection-slot" picking-mode="Ignore" style="top:0px;" />
            <ui:Instance template="RosterSlot" name="roster-slot-2" class="selection-slot selection-slot-second" picking-mode="Ignore" style="top:97px;" />
            <ui:Instance template="RosterSlot" name="roster-slot-3" class="selection-slot selection-slot-third" picking-mode="Ignore" style="top:194px;" />
            <ui:Instance template="RosterSlot" name="roster-slot-4" class="selection-slot selection-slot-fourth" picking-mode="Ignore" style="top:291px;" />
            <ui:Button name="delete-character" class="ff-button selection-padded roster-delete-character" style="left:47px; top:449px; width:188px; height:25px;"  />
            <ui:Button name="create-character" class="ff-button selection-padded roster-create-character" style="left:244px; top:449px; width:188px; height:25px;"  />
            <ui:Button name="enter-world" class="ff-button roster-enter-world" style="left:83px; top:503px; width:325px; height:57px;"  />
            <ui:Button name="music-toggle" class="ff-button roster-music-toggle" style="left:225px; top:567px; width:86px; height:30px;"  />
        </ui:VisualElement>
        <ui:Button name="quit" class="ff-button selection-padded roster-quit" style="left:20px; top:682px; width:90px; height:23px;"  />
        <ui:Button name="fullscreen" class="ff-button roster-fullscreen" style="left:1235px; top:685px; width:35px; height:31px;"  />
    </ui:VisualElement>
</ui:UXML>
