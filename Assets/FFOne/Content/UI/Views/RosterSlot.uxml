<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Button name="character-slot" class="ff-button selection-slot-button" style="left:43px; width:413px; height:67px;" />
    <ui:Label name="empty-slot" class="ff-label selection-padded selection-slot-empty" style="left:165px; width:172px; height:16px;" picking-mode="Ignore" />
    <ui:VisualElement name="disk-back" class="ff-artwork selection-disk selection-disk-back" style="left:23px; width:69px; height:23px;" picking-mode="Ignore" />
    <ui:Image scale-mode="StretchToFill" name="slot-preview" class="ff-artwork selection-slot-preview" style="left:26px; width:63px; height:85px;" picking-mode="Ignore" />
    <ui:VisualElement name="disk-front" class="ff-artwork selection-disk selection-disk-front" style="left:23px; width:69px; height:23px;" picking-mode="Ignore" />
    <ui:Label name="character-name" class="ff-label ff-label--chalet selection-padded selection-detail selection-slot-name" style="left:85px; width:370px; height:16px;" picking-mode="Ignore" />
    <ui:Label name="character-level" class="ff-label ff-label--chalet selection-padded selection-detail selection-slot-level" style="left:98px; width:97px; height:16px;" picking-mode="Ignore" />
    <ui:Label name="character-location" class="ff-label ff-label--chalet selection-padded selection-detail selection-slot-location" style="left:98px; width:250px; height:16px;" picking-mode="Ignore" />
</ui:UXML>
