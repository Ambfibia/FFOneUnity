<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Button name="server-row" class="ff-button ff-profile-button ff-server-row">
        <ui:VisualElement name="server-health" class="ff-server-health" picking-mode="Ignore" />
        <ui:Label name="server-name" class="ff-label ff-server-name" picking-mode="Ignore" enable-rich-text="false" />
        <ui:Label name="server-count" class="ff-label ff-server-count" picking-mode="Ignore" />
    </ui:Button>
</ui:UXML>
