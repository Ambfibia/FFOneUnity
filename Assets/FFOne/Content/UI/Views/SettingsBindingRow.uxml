<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:VisualElement class="option-mapping-row">
    <ui:Label class="option-small option-mapping-caption" enable-rich-text="false" picking-mode="Ignore" />
    <ui:Button class="ff-button option-button option-mapping-primary" />
    <ui:Button class="ff-button option-button option-mapping-alternate" />
    <ui:Button class="ff-button option-button option-mapping-pad" />
  </ui:VisualElement>
</ui:UXML>
