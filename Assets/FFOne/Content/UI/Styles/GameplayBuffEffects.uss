.gameplay-buffs { position: absolute; left: 28px; top: 260px; flex-direction: row; }
.gameplay-detectors { position: absolute; right: 24px; top: 140px; width: 230px; max-height: 240px; }
.gameplay-detector-copy { white-space: normal; font-size: 12px; }
.gameplay-buff-cell { width: 34px; height: 48px; margin-right: 3px; }
.gameplay-buff-icon { width: 32px; height: 32px; }
.gameplay-buff-timer { font-size: 10px; -unity-text-align: middle-center; }
