.ff-cashmall-list-skin { position:absolute; left:0; top:0; right:0; bottom:0; }
.ff-cashmall-list-back {
    left:0; top:20px; width:486px; height:485px;
    background-image:url("../Artwork/en/vendor/list-back.png");
    -unity-slice-left:6; -unity-slice-right:6; -unity-slice-top:14; -unity-slice-bottom:55;
}
.ff-cashmall-scroll-shadow {
    left:4px; top:35px; width:450px; height:412px;
    background-image:url("../Artwork/en/vendor/scroll-shadow.png");
    -unity-slice-top:32; -unity-slice-bottom:32;
}

.inventory-item-restricted > .retro-background, .vendor-item-restricted {
    background-image:url("../Artwork/en/vendor/restricted-item-frame.png");
    -unity-background-scale-mode:stretch-to-fill;
}
.vendor-item-restricted { position:absolute; left:1px; top:1px; width:62px; height:62px; }

.inventory-item-detail { display:none; position:absolute; left:0; right:0; top:0; bottom:0; align-items:center; justify-content:center; }
.inventory-item-detail--open { display:flex; }
.inventory-detail-window { width:310px; height:449px; position:relative; }
.inventory-detail-art { position:absolute; left:0; right:0; top:14px; bottom:0; background-image:url("../Artwork/en/user-equip/unequip-popup.png"); -unity-background-scale-mode:stretch-to-fill; }
.inventory-item-detail--equipped .inventory-detail-art { background-image:url("../Artwork/en/user-equip/equip-popup.png"); }
.inventory-detail-title, .inventory-detail-level, .inventory-detail-description, .inventory-detail-column > Label { -unity-font-definition:url("../Fonts/chaletbook-regular-sdf.asset"); font-size:15px; color:white; white-space:normal; }
.inventory-detail-title { position:absolute; left:88px; right:13px; top:47px; height:51px; -unity-font-definition:url("../Fonts/jeffe-sdf.asset"); -unity-text-align:middle-left; }
.inventory-detail-icon { position:absolute; left:16px; top:38px; width:62px; height:62px; }
.inventory-detail-level { position:absolute; left:14px; right:14px; top:127px; height:23px; -unity-text-align:middle-center; }
.inventory-detail-ratings { position:absolute; left:3px; top:157px; width:304px; height:84px; flex-direction:row; align-items:center; background-image:url("../Artwork/en/user-equip/equip-item-info.png"); }
.inventory-detail-column { flex-grow:1; flex-basis:0; }
.inventory-detail-column > Label { height:22px; -unity-text-align:middle-center; }
.inventory-detail-column > .inventory-rating--better { color:rgb(0,255,0); }
.inventory-detail-column > .inventory-rating--worse { color:rgb(230,51,0); }
.inventory-detail-description-box { position:absolute; left:13px; right:13px; top:250px; bottom:55px; }
.inventory-detail-description { font-size:14px; }
.inventory-detail-action { position:absolute; left:80px; right:80px; height:27px; bottom:16px; }
.inventory-detail-close { position:absolute; right:0; top:0; width:32px; height:32px; background-image:url("../Artwork/en/user-equip/close.png"); }
.inventory-detail-close:hover { background-image:url("../Artwork/en/user-equip/close-hover.png"); }

.ff-bank-panel { position:absolute; left:0; top:0; width:495px; height:638px; background-color:rgba(3,15,26,0.98); }
.ff-bank-info { position:absolute; left:3px; top:9px; width:481px; height:87px; background-image:url("../Artwork/en/bank-mode/bank-info.png"); }
.ff-bank-dialog { position:absolute; left:11px; top:105px; width:482px; height:531px; background-image:url("../Artwork/en/bank-mode/bank-panel.png"); -unity-slice-left:136; -unity-slice-right:10; -unity-slice-top:33; -unity-slice-bottom:51; }
.ff-bank-viewport { position:absolute; left:40px; top:139px; width:450px; height:445px; }
.ff-bank-grid { width:402px; height:2278px; flex-direction:row; flex-wrap:wrap; align-content:flex-start; flex-shrink:0; }
.ff-bank-slot {
    width:66px; height:66px; min-width:66px; min-height:66px; flex-grow:0; flex-shrink:0;
    margin:0 1px 1px 0; padding:0; border-width:0; background-color:transparent;
    background-image:url("../Artwork/en/character/selection/controls/blue_button_normal.png");
    -unity-slice-left:6; -unity-slice-right:6; -unity-slice-top:6; -unity-slice-bottom:4;
}
.ff-bank-slot:hover, .ff-bank-slot:focus { background-image:url("../Artwork/en/character/selection/controls/blue_button_over.png"); }
.ff-bank-search { position:absolute; left:242px; top:105px; width:250px; height:32px; background-image:url("../Artwork/en/bank-mode/search-field.png"); }
.ff-bank-query { position:absolute; left:64px; top:7px; width:177px; height:18px; margin:0; padding:0; font-size:11px; color:white; }
.ff-bank-query > .unity-text-input { margin:0; padding:1px 3px; border-width:0; color:white; background-image:url("../Artwork/en/launcher/login/ff-textfield-normal.png"); }
.ff-bank-grid--filtered { height:auto; }
.ff-bank-tab { position:absolute; left:-216px; top:0; width:130px; height:29px; padding:3px 0; color:white; font-size:12px; -unity-text-align:middle-center; }
