/* The five-column cabinet is also mounted by Mail, Trade, vendor and C.R.O.C. */
.inventory-screen .inventory-copy { color:rgb(204,255,255); }
.inventory-screen .inventory-item-count { position:absolute; right:3px; bottom:2px; color:white; font-size:12px; }
.inventory-item-image { position:absolute; left:0; top:0; right:0; bottom:0; }
.inventory-screen .inventory-item-caption { position:absolute; left:1px; top:0; width:61px; height:10px; font-size:8px; color:rgb(204,255,255); -unity-text-align:upper-right; }
.inventory-bag-slot, .inventory-nano-collection-slot {
    position:relative; left:auto; top:auto; width:67px; height:67px; flex-shrink:0;
    margin:0 2px 2px 0;
}
.inventory-bag-slot .inventory-item-caption { display:none; }
.inventory-equipment-slot { position:absolute; left:0; width:64px; height:64px; }
.inventory-grid, .nano-inventory-grid { left:6px; top:36px; width:366px; height:500px; }
.inventory-slots, .nano-inventory-slots { width:345px; min-height:500px; flex-direction:row; flex-wrap:wrap; align-content:flex-start; }
.inventory-slot-template, .croc-workshop-template { display:none; }
.inventory-frame { left:0; top:0; width:380px; height:632px; }
.inventory-frame > .retro-background {
    background-image:url("../Artwork/en/user-equip/inventory-panel.png");
    -unity-slice-left:136; -unity-slice-right:10; -unity-slice-top:33; -unity-slice-bottom:77;
}
.inventory-screen.inventory-show-nanos .inventory-frame > .retro-background {
    background-image:url("../Artwork/en/user-equip/nano-back.png");
    -unity-slice-left:219; -unity-slice-right:10; -unity-slice-top:34; -unity-slice-bottom:77;
}
.inventory-screen .inventory-tab { background-image:none; }
.inventory-screen .inventory-tab.inventory-tab-selected { background-image:none; }
.inventory-screen .inventory-equipment-tab { left:0; top:0; width:142px; height:29px; }
.inventory-screen .inventory-nanos-tab { left:96px; top:0; width:129px; height:29px; }
.inventory-tab > .retro-text { -unity-font-definition:url("../Fonts/jeffe-sdf.asset"); font-size:12px; }
.equipment-title > .equipment-title-caption { font-size:9px; }
.inventory-screen .nano-inventory-grid, .inventory-screen .inventory-inactive-equipment,
.inventory-screen.inventory-show-nanos .inventory-grid, .inventory-screen.inventory-show-nanos .inventory-inactive-nanos,
.inventory-screen.inventory-read-only .inventory-inactive-equipment, .inventory-screen.inventory-read-only .inventory-inactive-nanos { display:none; }
.inventory-screen.inventory-show-nanos .nano-inventory-grid,
.inventory-screen.inventory-show-nanos .inventory-inactive-equipment { display:flex; }
.inventory-screen.inventory-show-nanos.inventory-read-only .inventory-inactive-equipment { display:none; }
.inventory-screen .inventory-player-level { color:yellow; }
.inventory-screen .inventory-nano-power { color:red; }

