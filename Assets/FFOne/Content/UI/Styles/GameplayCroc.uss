/* The cabinet comes from Inventory.uxml and uses the same item slots. */
.croc-copy {
    color:white; font-size:10px; white-space:normal; -unity-text-align:middle-left;
}
.croc-copy.croc-copy--body {
    font-size:12px;
    -unity-font-definition:url("../Fonts/chaletbook-regular-sdf.asset");
}
.croc-copy.croc-copy--center { -unity-text-align:middle-center; }
.croc-action {
    font-size:12px;
    background-image:url("../Artwork/en/combi/button-normal.png");
    -unity-background-scale-mode:stretch-to-fill;
    -unity-slice-left:6; -unity-slice-right:6; -unity-slice-top:6; -unity-slice-bottom:4;
}
.croc-action:hover, .croc-action:focus, .croc-action:active {
    background-image:url("../Artwork/en/combi/button-hover.png");
    color:rgb(0,36,62);
}
.croc-drop-area { background-color:transparent; background-image:none; }
.croc-view .croc-hidden { display:none; }
.croc-background { left:0px; top:0px; width:585px; height:653px; background-image:url("../Artwork/en/combi/panel.png"); }

.croc-npc { left:363px; top:2px; width:143px; height:128px; }

.croc-title { left:28px; top:19px; width:299px; height:16px; }

.croc-intro { left:28px; top:36px; width:327px; height:49px; -unity-text-align:middle-center; }

.croc-style-caption, .croc-stats-caption {
    left:41px; width:76px; height:14px; font-size:9px; white-space:nowrap; -unity-text-align:middle-center;
}
.croc-style-caption { top:154px; }

.croc-stats-caption { top:340px; }

.croc-new {
    left:248px; top:149px; width:151px; height:13px; font-size:8px; white-space:nowrap;
    -unity-text-align:middle-center; color:rgb(0,39,61);
}

