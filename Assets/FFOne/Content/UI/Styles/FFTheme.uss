.ff-screen { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.ff-artwork { position: absolute; -unity-background-scale-mode: stretch-to-fill; }
.ff-label { margin: 0; padding: 0; white-space: nowrap; -unity-font-definition: url("../Fonts/jeffe-sdf.asset"); font-size: 14px; }
.ff-button {
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(229, 229, 229);
    -unity-text-align: middle-center;
    white-space: nowrap;
    -unity-slice-scale: 1;
    -unity-font-definition: url("../Fonts/jeffe-sdf.asset");
    font-size: 14px;
}
.ff-button--primary {
    padding: 4px 8px;
    background-image: url("../Artwork/en/server-selection/ff-button-normal.png");
    -unity-slice-left: 5; -unity-slice-right: 5; -unity-slice-top: 5; -unity-slice-bottom: 5;
}
.ff-button--primary:hover, .ff-button--primary:focus { background-image: url("../Artwork/en/server-selection/ff-button-hover.png"); }
.ff-button--primary:active { background-image: url("../Artwork/en/server-selection/ff-button-active.png"); }
.ff-button:hover, .ff-button:focus, .ff-button:active { color: white; }
.ff-button:disabled { opacity: 0.5; }
.ff-input {
    margin: 0; padding: 0; border-width: 0; border-radius: 0;
    -unity-font-definition: url("../Fonts/chaletbook-regular-sdf.asset"); font-size: 14px;
    background-image: url("../Artwork/en/launcher/login/ff-textfield-normal.png");
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 2; -unity-slice-bottom: 2;
}
.ff-input > .unity-text-field__input {
    margin: 0;
    padding: 5px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: rgb(230, 230, 230);
    -unity-text-align: middle-left;
    --unity-selection-color: rgba(30, 160, 220, 0.65);
    --unity-cursor-color: white;
}
.ff-input > .creation-name-input { color: yellow; }
