.transport-backdrop { position:absolute; left:0px; top:0px; width:1920px; height:1440px; background-image:url("../Artwork/en/Controls/panelback.png"); -unity-background-scale-mode:stretch-to-fill; }
.transport-window { position:absolute; left:0px; top:0px; width:1036px; height:654px; }
.transport-right { position:absolute; left:379px; top:0px; width:658px; height:652px; }
.transport-left { position:absolute; left:0px; top:0px; width:380px; height:652px; }
.transport-left-box { position:absolute; left:17px; top:65px; width:343px; height:577px; }
.transport-map, .transport-markers, .transport-scan { position:absolute; left:390px; top:10px; width:590px; height:630px; }
.transport-markers, .transport-scan { overflow:hidden; }
.transport-grid { position:absolute; left:0px; top:0px; width:590px; height:630px; background-image:url("../Artwork/en/world-map/overlays/line_main.png"); -unity-background-scale-mode:stretch-to-fill; }
.transport-scan-large { position:absolute; left:0px; top:-64px; width:590px; height:64px; background-image:url("../Artwork/en/world-map/overlays/line_main00.png"); -unity-background-scale-mode:stretch-to-fill; }
.transport-scan-small { position:absolute; left:0px; top:0px; width:590px; height:4px; background-image:url("../Artwork/en/world-map/overlays/line_main01.png"); -unity-background-scale-mode:stretch-to-fill; }
.transport-root .transport-title { position:absolute; left:10px; top:7px; width:300px; height:20px; -unity-text-align:middle-center; font-size:16px; }
.transport-root .transport-subtitle { position:absolute; left:80px; top:29px; width:180px; height:18px; -unity-text-align:middle-center; font-size:12px; }
.transport-npc { position:absolute; left:20px; top:34px; width:90px; height:90px; }
.transport-bubble { position:absolute; left:127px; top:53px; width:200px; height:44px; background-image:url("../Artwork/en/transportation/decor/bubble.png"); -unity-background-scale-mode:stretch-to-fill; }
.transport-root .transport-where { position:absolute; left:182px; top:65px; width:140px; height:20px; color:black; -unity-text-align:middle-left; font-size:16px; }
.transport-routes { position:absolute; left:20px; top:148px; width:340px; height:445px; }
.transport-routes .unity-scroller--vertical { width:17px; }
.transport-routes .unity-scroller--vertical .unity-scroller__low-button { background-color:transparent; border-width:0; border-radius:0; height:12px; background-image:url("../Artwork/en/user-equip/scroll-up.png"); -unity-background-scale-mode:stretch-to-fill; }
.transport-routes .unity-scroller--vertical .unity-scroller__high-button { background-color:transparent; border-width:0; border-radius:0; height:12px; background-image:url("../Artwork/en/user-equip/scroll-down.png"); -unity-background-scale-mode:stretch-to-fill; }
.transport-routes .unity-scroller--vertical .unity-base-slider__tracker { background-color:transparent; border-width:0; border-radius:0; background-image:url("../Artwork/en/user-equip/scroll-track.png"); -unity-background-scale-mode:stretch-to-fill; -unity-slice-left:2; -unity-slice-bottom:4; -unity-slice-right:2; -unity-slice-top:4; }
.transport-routes .unity-scroller--vertical .unity-base-slider__dragger { background-color:transparent; border-width:0; border-radius:0; background-image:url("../Artwork/en/user-equip/scroll-thumb.png"); -unity-background-scale-mode:stretch-to-fill; -unity-slice-left:2; -unity-slice-bottom:4; -unity-slice-right:2; -unity-slice-top:4; }
.transport-root .transport-close { position:absolute; left:995px; top:8px; width:32px; height:32px; background-image:url("../Artwork/en/user-equip/close.png"); -unity-background-scale-mode:stretch-to-fill; }
.transport-root .transport-close:hover, .transport-root .transport-close:focus, .transport-root .transport-close:active { background-image:url("../Artwork/en/user-equip/close-hover.png"); -unity-background-scale-mode:stretch-to-fill; }
.transport-root .transport-action { font-size:12px; background-image:url("../Artwork/en/character/selection/controls/blue_button_normal.png"); -unity-background-scale-mode:stretch-to-fill; -unity-slice-left:5; -unity-slice-bottom:5; -unity-slice-right:5; -unity-slice-top:5; }
.transport-root .transport-action:hover, .transport-root .transport-action:focus, .transport-root .transport-action:active { background-image:url("../Artwork/en/character/selection/controls/blue_button_over.png"); -unity-background-scale-mode:stretch-to-fill; }
.transport-go { position:absolute; left:213px; top:604px; width:132px; height:26px; }
.transport-register { position:absolute; left:55px; top:118px; width:170px; height:26px; }
.transport-turbo-controls { position:absolute; left:0; right:0; top:0; bottom:0; }
.transport-turbo-background { position:absolute; left:30px; top:604px; width:26px; height:26px; background-image:url("../Artwork/en/character/selection/controls/blue_button_normal.png"); -unity-background-scale-mode:stretch-to-fill; }
.transport-turbo-check { position:absolute; left:33px; top:607px; width:20px; height:20px; background-image:url("../Artwork/en/character/selection/controls/blue_button_over.png"); -unity-background-scale-mode:stretch-to-fill; }
.transport-turbo-title { position:absolute; left:60px; top:610px; width:150px; height:26px; -unity-text-align:middle-left; }
.transport-turbo { position:absolute; left:30px; top:604px; width:170px; height:26px; }
.transport-hidden { display:none; }
.transport-marker { position:absolute; left:0px; top:0px; width:36px; height:36px; }
.transport-route-row.ff-button { width:295px; height:75px; flex-shrink:0; margin:5px 0 2px 10px; background-image:url("../Artwork/en/transportation/skin/route_row.png"); -unity-background-scale-mode:stretch-to-fill; }
.transport-route-selection { position:absolute; left:-1px; top:-1px; width:297px; height:77px; background-image:url("../Artwork/en/transportation/skin/route_selected.png"); -unity-background-scale-mode:stretch-to-fill; }
.transport-route-icon-back { position:absolute; left:8px; top:5px; width:64px; height:64px; background-image:url("../Artwork/en/transportation/skin/icon_box.png"); -unity-background-scale-mode:stretch-to-fill; }
.transport-route-icon { position:absolute; left:10px; top:7px; width:60px; height:60px; }
.transport-route-name { position:absolute; left:83px; top:14px; width:200px; height:20px; -unity-text-align:middle-left; }
.transport-route-region { position:absolute; left:83px; top:34px; width:200px; height:20px; -unity-text-align:middle-left; }
.transport-route-taros { position:absolute; left:263px; top:45px; width:31px; height:31px; background-image:url("../Artwork/en/transportation/decor/taros.png"); -unity-background-scale-mode:stretch-to-fill; }
.transport-route-fare.ff-label { position:absolute; left:133px; top:50px; width:130px; height:25px; -unity-text-align:middle-right; font-size:12px; color:white; }
.transport-route-fare.ff-label.transport-fare--turbo { color:yellow; }
.transport-route-fare.ff-label.transport-fare--unavailable { color:red; }
