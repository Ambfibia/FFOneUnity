.party-level { left:40px; top:25px; width:25px; height:20px; -unity-text-align:middle-center; }
.party-health { height:4px; background-image:url("../Artwork/en/gameplay/group/hp_bar.png"); }
.party-member-health { left:7px; top:17px; }
.party-nano { position:absolute; left:0; right:0; top:0; bottom:0; }
.party-nano-name { left:60px; top:15px; width:96px; height:20px; }
.party-nano-frame {
    left:60px; top:35px; width:111px; height:6px;
    background-image:url("../Artwork/en/gameplay/group/group_nano_hpframe.png");
}
.party-nano-health { left:61px; top:36px; }
.party-nano-skill { position:absolute; left:172px; top:21px; width:26px; height:26px; }
.party-npc-frame {
    left:5px; top:0; width:192px; height:28px;
    background-image:url("../Artwork/en/gameplay/group/npc_co_op.png");
}
.party-npc-hp { left:10px; top:17px; }
