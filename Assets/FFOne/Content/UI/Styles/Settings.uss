.option-overlay { display:none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.5); }
.option-overlay--open { display:flex; }
.option-window { position:absolute; width:1020px; height:638px; transform-origin:0 0; -unity-font-definition: url("../Fonts/chaletbook-regular-sdf.asset"); color: white; }
.option-frame { -unity-background-scale-mode:stretch-to-fill; background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/outer-frame.png"); -unity-slice-left: 10; -unity-slice-right: 10; -unity-slice-top: 10; -unity-slice-bottom: 10; }
.option-flat { background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/panel-flat.png"); }
.option-sky { background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/frame.png"); }
.option-notch { background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/panel-notch.png"); }
.option-side { background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/panel-side.png"); -unity-slice-left: 10; -unity-slice-right: 10; -unity-slice-top: 10; -unity-slice-bottom: 10; }
.option-small { margin: 0; padding: 0; font-size: 12px; color: white; -unity-text-align: middle-left; }
VisualElement.option-small { background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/panel-small.png"); -unity-slice-left: 10; -unity-slice-right: 10; -unity-slice-top: 10; -unity-slice-bottom: 10; }
.option-connector { background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/panel-connector.png"); -unity-slice-left: 6; -unity-slice-right: 35; }
.option-label { margin: 0; padding: 0; font-size: 12px; -unity-text-align: middle-right; white-space: nowrap; }
.option-title, .option-cyan { margin: 0; padding: 0; font-size: 11px; -unity-font-definition: url("../Fonts/jeffe-sdf.asset"); -unity-text-align: middle-left; color: rgb(204,255,255); }
.option-title { color: rgb(15,55,65); }
.option-description { margin: 0; padding: 0; font-size: 13px; white-space: normal; }
.option-ru .option-page-social > .option-description { font-size: 9.5px; }
.option-ru .option-button { font-size: 10px; }
.option-button { -unity-background-scale-mode:stretch-to-fill; font-size: 11.3px; background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/button.png"); -unity-slice-left: 8; -unity-slice-right: 8; -unity-slice-top: 5; -unity-slice-bottom: 5; padding: 0 8px; }
.option-button:hover, .option-button:focus { background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/button-hover.png"); }
.option-close { -unity-background-scale-mode:scale-to-fit; background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/close.png"); }
.option-close:hover, .option-close:focus { background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/close-hover.png"); }
.option-tab { position:absolute; -unity-background-scale-mode:stretch-to-fill; color: rgb(204,255,255); font-size: 12px; }
/* Source tab content offsets affect text inside its hit box, not the image. */
.tab-graphics { -unity-text-align:middle-left; padding-left:10px; padding-bottom:8px; }
.tab-graphics.selected, .tab-game-ui.selected { padding-bottom:10px; }
.tab-social { padding-bottom:3px; }
.tab-social.selected { padding-bottom:12px; padding-right:4px; }
.tab-controls { -unity-text-align:middle-right; padding-right:24px; padding-bottom:11px; }
.tab-controls.selected { padding-top:3px; padding-bottom:0; }
.tab-graphics { left:8px; top:19px; width:275px; height:44px; background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/tab-graphics.png"); -unity-slice-bottom: 3; }
.tab-graphics:hover { background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/tab-graphics-hover.png"); }
.tab-graphics.selected { left:8px; top:17px; width:271px; height:49px; background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/tab-graphics-selected.png"); -unity-slice-bottom: 0; }
.tab-game-ui { left:330px; top:21px; width:188px; height:32px; background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/tab-game-ui.png"); }
.tab-game-ui:hover { background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/tab-game-ui-hover.png"); }
.tab-game-ui.selected { left:329px; top:19px; width:192px; height:44px; background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/tab-game-ui-selected.png"); }
.tab-social { left:560px; top:21px; width:189px; height:33px; background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/tab-social.png"); }
.tab-social:hover { background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/tab-social-hover.png"); }
.tab-social.selected { left:557px; top:20px; width:197px; height:44px; background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/tab-social-selected.png"); }
.tab-controls { left:798px; top:19px; width:196px; height:45px; background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/tab-controls.png"); }
.tab-controls:hover { background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/tab-controls-hover.png"); }
.tab-controls.selected { left:799px; top:3px; width:194px; height:61px; background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/tab-controls-selected.png"); }
.option-radio { background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/radio-empty.png"); }
.option-radio.selected { background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/radio-checked.png"); }
.option-dropdown {
    font-size:12px; -unity-font-definition:url("../Fonts/chaletbook-regular-sdf.asset");
    padding-right:27px;
    background-image:url("../Artwork/en/option/pulldown.png");
    -unity-background-scale-mode:stretch-to-fill;
    -unity-slice-left:6; -unity-slice-right:27; -unity-slice-top:5; -unity-slice-bottom:5;
}
.option-dropdown:hover { background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/pulldown-hover.png"); }
.option-choices {
    position:absolute;
    padding:4px 8px;
    background-image:url("../Artwork/en/option/dropdown-panel.png");
    -unity-background-scale-mode:stretch-to-fill;
    -unity-slice-left:15; -unity-slice-right:15; -unity-slice-top:14; -unity-slice-bottom:14;
}
.option-choice { height: 23px; font-size: 12px; -unity-font-definition: url("../Fonts/chaletbook-regular-sdf.asset"); }
.option-choice:hover, .option-choice:focus { background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/dropdown-item-hover.png"); color:rgb(0,49,82); }
.option-slider { margin: 0; padding: 0; }
.option-slider .unity-base-slider__input { margin: 0; padding: 0; }
.option-slider .unity-base-slider__tracker { height: 16px; top: 5px; border-width: 0; border-radius: 0; background-color: transparent; background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/slider-track.png"); }
.option-slider .unity-base-slider__dragger { width: 13px; height: 27px; top: 0; border-width: 0; border-radius: 0; background-color: transparent; background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/slider-thumb.png"); }
.option-slider-range-start { -unity-text-align:middle-right; padding-bottom:1px; }
.option-page-graphics .option-label,
.option-page-graphics Label.option-small { padding-bottom:1px; }
.option-list { background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/textfield.png"); -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 2; -unity-slice-bottom: 2; }
.option-list .unity-scroller--vertical,
.option-choices-list .unity-scroller--vertical { width: 17px; }
.option-list .unity-scroller--vertical .unity-base-slider__tracker,
.option-choices-list .unity-scroller--vertical .unity-base-slider__tracker { background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/scroll-bar.png"); border-width: 0; border-radius: 0; }
.option-list .unity-scroller--vertical .unity-base-slider__dragger,
.option-choices-list .unity-scroller--vertical .unity-base-slider__dragger { background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/scroll-thumb.png"); border-width: 0; border-radius: 0; }
.option-list .unity-scroller--vertical .unity-base-slider__tracker,
.option-choices-list .unity-scroller--vertical .unity-base-slider__tracker,
.option-list .unity-scroller--vertical .unity-base-slider__dragger,
.option-choices-list .unity-scroller--vertical .unity-base-slider__dragger {
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 4; -unity-slice-bottom: 4;
}
.option-list .unity-scroller--vertical .unity-scroller__low-button,
.option-choices-list .unity-scroller--vertical .unity-scroller__low-button { background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/scroll-up.png"); }
.option-list .unity-scroller--vertical .unity-scroller__high-button,
.option-choices-list .unity-scroller--vertical .unity-scroller__high-button { background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/scroll-down.png"); }
.option-swatch { width: 20px; height: 20px; font-size: 10px; -unity-font-definition: url("../Fonts/chaletbook-regular-sdf.asset"); background-image: url("/Assets/FFOne/Content/UI/Artwork/en/option/color-box.png"); }
/* The marker overflows the 20px swatch without changing its hit rectangle. */
.option-swatch-marker { display:none; position:absolute; left:-2px; top:-2px; width:24px; height:24px; background-image:url('../Artwork/en/option/color-selected.png'); -unity-background-scale-mode:stretch-to-fill; }
.option-swatch.selected .option-swatch-marker { display:flex; }
.option-swatch-row { height:30px; flex-direction:row; }
.option-swatch-slot { width:30px; height:30px; flex-shrink:0; }
.option-binding { font-size: 12px; -unity-font-definition: url("../Fonts/chaletbook-regular-sdf.asset"); }


.option-blocked-player--selected {
    background-image:url('../Artwork/en/option/row-selected.png');
}

.option-page { display:none; }
.option-page--selected { display:flex; }
.option-popup-layer, .option-modal-shield { position:absolute; left:0; top:0; right:0; bottom:0; }
.option-popup-message { display:none; }
.option-popup-message--open { display:flex; }
.option-message-box { position:absolute; left:285px; top:210px; width:450px; height:210px; }
.option-message-text { position:absolute; left:35px; top:35px; width:380px; height:100px; }
.option-message-ok { position:absolute; left:135px; top:155px; width:180px; height:25px; }
.option-choices-list { max-height:322px; }
.option-choice { flex-shrink:0; }
.option-blocked-player { height:16px; }

.option-mappings { height:1140px; flex-shrink:0; }
.option-mapping-group .option-title { color:rgb(204,255,255); }
.option-mapping-rows { position:absolute; left:0; right:0; }
.option-mapping-row-instance, .option-mapping-row { position:relative; height:30px; flex-shrink:0; }
.option-mapping-caption { position:absolute; left:20px; top:0; width:155px; height:25px; }
.option-mapping-row > Button { position:absolute; top:0; width:180px; height:25px; }
.option-mapping-primary { left:180px; }
.option-mapping-alternate { left:400px; }
.option-mapping-pad { left:620px; }
