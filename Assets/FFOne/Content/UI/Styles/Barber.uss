.ff-barber-screen { position:absolute; left:0; top:0; right:0; bottom:0; justify-content:center; align-items:center; background-color:rgba(0, 0, 0, .72); }
.barber-panel { width:80%; max-width:860px; min-height:400px; max-height:96%; padding:18px; background-color:rgb(15, 34, 53); border-color:rgb(78, 148, 180); border-width:2px; }
.barber-title { font-size:24px; -unity-text-align:middle-center; margin-bottom:12px; }
.barber-columns, .barber-footer, .barber-option { flex-direction:row; align-items:center; }
.barber-columns { flex-grow:1; }
.barber-avatar { width:36%; height:310px; flex-shrink:0; }
.barber-controls { flex-grow:1; flex-shrink:1; padding:8px; }
.barber-step { font-size:18px; padding-bottom:10px; }
.barber-option { height:34px; }
.barber-field { flex-grow:1; }
.barber-value { width:52px; -unity-text-align:middle-center; }
.barber-prev, .barber-next { width:32px; height:28px; font-size:18px; }
.barber-status { white-space:normal; color:rgb(255,214,142); margin-top:8px; }
.barber-total { font-size:17px; margin-top:8px; }
.barber-footer { margin-top:12px; flex-wrap:wrap; justify-content:flex-end; }
.barber-footer > Button { min-height:30px; margin:2px; padding-left:8px; padding-right:8px; white-space:normal; }
.mission-journal-contact { position:absolute; top:77px; left:287px; width:251px; height:52px; display:none; }
.mission-contact-portrait { position:absolute; left:0; top:1px; width:48px; height:48px; }
.mission-contact-name, .mission-contact-location { position:absolute; left:54px; right:0; height:20px; -unity-text-align:middle-left; font-size:13px; color:rgb(255,255,255); }
.mission-contact-name { top:4px; }
.mission-contact-location { top:25px; }
