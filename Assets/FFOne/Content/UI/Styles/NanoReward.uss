.nano-reward-screen { position:absolute; left:0; right:0; top:0; bottom:0; }
.nano-reward-bar { position:absolute; left:0; right:0; height:15.674%; background-color:black; }
.nano-reward-bar-top { top:0; }
.nano-reward-bar-bottom { bottom:0; }
.nano-reward-panel {
    position:absolute; left:50%; top:50%; margin-left:100px; margin-top:-230px; width:356px; height:460px;
    background-image:url('../Artwork/en/nano-free-tuning/three_power_panel.png');
    -unity-background-scale-mode:stretch-to-fill;
}
.nano-reward-title, .nano-reward-name, .nano-reward-description {
    position:absolute; padding:0; margin:0; -unity-font-definition:url('../Fonts/jeffe-sdf.asset');
}
.nano-reward-title { left:100px; top:97px; right:12px; height:28px; color:yellow; font-size:16px; }
.nano-reward-power { position:absolute; left:18px; right:18px; height:77px; }
.nano-reward-first { top:139px; }
.nano-reward-second { top:221px; }
.nano-reward-third { top:304px; }
.nano-reward-icon { position:absolute; left:0; top:0; width:35px; height:35px; }
.nano-reward-name { left:36px; top:1px; right:102px; height:37px; white-space:normal; color:white; font-size:13px; }
.nano-reward-description { left:2px; top:39px; right:1px; height:38px; white-space:normal; color:rgb(131,223,255); font-size:11px; }
.nano-reward-select { position:absolute; right:4px; top:5px; width:97px; height:22px; padding:0; margin:0;
    background-image:url('../Artwork/en/combi/button-normal.png'); -unity-background-scale-mode:stretch-to-fill; color:white; font-size:11px; }
.nano-reward-select:hover,.nano-reward-select:focus { background-image:url('../Artwork/en/combi/button-hover.png'); }
