.mail-attach-template { width:132px; height:25px; margin-right:3px; }
.mail-compose-item-template { height:29px; flex-shrink:0; color:white; background-color:rgb(6,36,54); }
.mail-inbox--read .mail-form-template,
.mail-inbox--compose .mail-list,
.mail-inbox--compose .mail-table-art, .mail-inbox--compose .mail-empty-folder,
.mail-inbox--compose .mail-inbox-detail, .mail-inbox--compose .mail-heading-from, .mail-inbox--compose .mail-heading-subject,
.mail-inbox--compose .mail-heading-day, .mail-inbox--compose .mail-heading-attachment,
.mail-inbox--compose .mail-previous, .mail-inbox--compose .mail-next, .mail-inbox--compose .mail-page, .mail-hidden { display:none; }
.mail-copy, .mail-action, .mail-page-action, .mail-folder-tab { color:rgb(204,255,255); font-size:12px; }
.mail-copy { -unity-font-definition:url("../Fonts/jeffe-sdf.asset"); margin:0; padding:0; white-space:nowrap; -unity-text-align:middle-left; }
.mail-copy.mail-copy--body, .ff-button.mail-copy--body { -unity-font-definition:url("../Fonts/chaletbook-regular-sdf.asset"); }
.mail-detail-body { color:rgb(25,25,25); white-space:normal; }
.mail-action {
    background-image:url("../Artwork/en/character/selection/controls/blue_button_normal.png");
    -unity-background-scale-mode:stretch-to-fill;
    -unity-slice-left:6; -unity-slice-right:6; -unity-slice-top:6; -unity-slice-bottom:4;
}
.mail-action:hover, .mail-action:focus, .mail-action:active {
    background-image:url("../Artwork/en/character/selection/controls/blue_button_over.png");
    color:rgb(0,36,62);
}
.mail-page-action { font-size:14px; }
.mail-previous { -unity-slice-left:10; -unity-slice-bottom:10; -unity-slice-right:4; -unity-slice-top:4; }
.mail-next { -unity-slice-left:4; -unity-slice-bottom:10; -unity-slice-right:10; -unity-slice-top:4; }
.mail-folder-tab { -unity-text-align:middle-left; }
.mail-inbox--guide .mail-guide-tab, .mail-inbox--player .mail-player-tab { color:white; }
.mail-attachments { flex-direction:row; }
.mail-copy.mail-heading-from, .mail-copy.mail-heading-subject, .mail-copy.mail-heading-day,
.mail-copy.mail-empty-folder, .mail-copy.mail-no-selection, .mail-copy.mail-page { -unity-text-align:middle-center; }
.mail-message--attached .mail-read-body { height:117px; }
.mail-message--attached .mail-paper-art { height:140px; }
.mail-inbox--player .mail-from-caption, .mail-inbox--player .mail-subject-caption { left:10px; }
.mail-inbox--player .mail-detail-from { left:70px; }
.mail-inbox--player .mail-detail-subject { left:95px; }
.mail-row-item:hover { background-color:rgb(2,52,72); }
.mail-row-unselected .mail-row-selection, .mail-row-no-attachment .mail-row-attachment { display:none; }
.mail-row-selected .mail-copy { color:rgb(0,38,66); }
.mail-field { margin:0; padding:0; font-size:13px; -unity-font-definition:url("../Fonts/chaletbook-regular-sdf.asset"); }
.mail-field .unity-base-field__label { min-width:128px; color:rgb(204,255,255); -unity-text-align:middle-left; }
.mail-form-template .mail-field .unity-base-text-field__input,
.mail-form-template .mail-field .unity-text-field__input,
.mail-form-template .mail-field .unity-base-popup-field__input {
    height:100%; margin:0; padding:0 6px; -unity-text-align:middle-left; color:white;
    background-color:rgb(6,25,41); border-width:1px; border-color:rgb(41,128,166);
}
.mail-form-template .mail-field--paper .unity-base-text-field__input,
.mail-form-template .mail-field--paper .unity-text-field__input,
.mail-form-template .mail-field--paper .unity-text-field__input--multiline {
    padding:6px; -unity-text-align:upper-left; color:rgb(18,54,56); background-color:rgb(158,250,250);
}
.mail-field--paper .unity-text-element { color:rgb(18,54,56); }
.mail-field--paper .unity-base-field__label { display:none; }
.mail-copy.mail-from-caption, .mail-copy.mail-subject-caption { color:yellow; }
.mail-copy.mail-cost { font-size:13px; }
.mail-copy.mail-status { font-size:10px; }
.mail-copy.mail-detail-body { color:rgb(25,25,25); white-space:normal; }

.mail-form-surface { background-color:rgb(2,41,72); border-width:2px; border-color:rgb(68,151,168); border-radius:9px; }
