.npc-mission-screen { position:absolute; left:0; top:0; right:0; bottom:0; }
.npc-conversation-fade { position:absolute; left:0; top:0; right:0; bottom:0; background-color:black; opacity:0; }
.npc-mission-panel { position:absolute; left:75%; top:50%; translate:-50% -50%; width:332px; }
.npc-mission-top { height:50px; flex-shrink:0; }
.npc-mission-name { position:absolute; left:15px; top:10px; width:277px; height:40px; font-size:16px; color:white; -unity-font-definition:url('../Fonts/jeffe-sdf.asset'); -unity-text-align:middle-left; }
.npc-mission-body { min-height:1px; max-height:345px; padding-bottom:5px; }
.npc-mission-section { margin:0 4px 0 0; height:20px; padding:0; background-image:url('../Artwork/en/gameplay/journal/sel_bar.png'); -unity-text-align:middle-center; color:white; }
.npc-mission-panel .npc-mission-option { width:312px; min-height:27px; height:auto; padding:3px 7px 3px 28px; margin:5px 0 0 7px; flex-shrink:0; }
.npc-mission-option-icon { position:absolute; width:17px; height:17px; left:8px; top:50%; translate:0 -50%; }
.npc-mission-option-title { align-self:stretch; white-space:normal; margin:0; padding:0; font-size:15px; -unity-font-definition:url('../Fonts/jeffe-sdf.asset'); color:white; -unity-text-align:middle-center; }
.npc-mission-bottom { height:76px; flex-shrink:0; align-items:center; padding-top:14px; }
.npc-mission-close { width:212px; height:48px; margin:0; padding:0; color:white; -unity-text-align:middle-center; background-image:url('../Artwork/en/character/selection/controls/blue_button_normal.png'); -unity-slice-left:6; -unity-slice-top:5; -unity-slice-right:6; -unity-slice-bottom:5; }
.npc-mission-close:hover, .npc-mission-close:focus { background-image:url('../Artwork/en/character/selection/controls/blue_button_over.png'); }
.npc-mission-exit-icon { position:absolute; left:8px; top:8px; width:38px; height:32px; background-image:url('../Artwork/en/gameplay/mission/npc/npcicon_exit.png'); }
