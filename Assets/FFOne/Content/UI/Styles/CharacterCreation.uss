.creation-rect, .creation-panel { position: absolute; }
.creation-panel { transform-origin: 50% 50%; }
.creation-label { color: rgb(204, 255, 255); -unity-text-align: middle-center; }
.creation-cyan { color: cyan; font-size: 12px; }
.creation-name-wheel { overflow: hidden; }
.creation-name-wheel .creation-label { padding: 4px 6px 6px 10px; }
.creation-panel .creation-gender .creation-label { overflow: hidden; }
.creation-panel #choose-body, .creation-panel #choose-features, .creation-panel #choose-clothes { -unity-text-align: middle-left; }
.creation-panel #creation-title { padding-top: 3px; padding-bottom: 3px; }
.creation-panel #generated-name, .creation-panel #custom-name { padding-bottom: 5px; font-size: 12px; }
.creation-panel #name-or, .creation-panel #selected-name-tab { padding-top: 4px; padding-bottom: 7px; font-size: 12px; }
.creation-panel #name-help, .creation-panel #creation-error { white-space: normal; }
.creation-panel #name-question { font-size: 12px; color: white; }
.creation-panel #name-display { color: yellow; font-size: 12px; }
.creation-panel #creation-exit, .creation-panel #appearance-exit { padding: 4px 6px 6px 6px; }
.character-creation .creation-gender, .character-creation .creation-exit { color: rgb(204, 255, 255); }
.character-creation .ff-button:hover, .character-creation .ff-button:focus, .character-creation .ff-button:active { color: rgb(0, 71, 122); }
.character-creation .creation-exit:hover, .character-creation .creation-exit:focus, .character-creation .creation-exit:active { color: rgb(165, 192, 192); }
