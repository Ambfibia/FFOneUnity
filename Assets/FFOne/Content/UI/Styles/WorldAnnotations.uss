.world-annotations { position:absolute; left:0; top:0; right:0; bottom:0; overflow:hidden; }
.world-annotation { position:absolute; display:none; translate:-50% -100%; transform-origin:50% 100%; }
.world-annotation--visible { display:flex; }
.world-nameplate-copy {
    margin:0; padding:0; white-space:nowrap; font-size:14px;
    -unity-font-definition:url('../Fonts/chaletbook-regular-sdf.asset');
    -unity-text-outline-width:1px; -unity-text-outline-color:black;
    color:rgb(202,255,255);
}
.world-nameplate-vitals { display:none; flex-direction:row; align-items:center; justify-content:center; }
.world-nameplate--player .world-nameplate-vitals { display:flex; }
.world-nameplate-level { margin:0; padding:0 3px 0 0; color:white; font-size:11px; -unity-font-definition:url('../Fonts/chaletbook-regular-sdf.asset'); -unity-text-outline-width:1px; -unity-text-outline-color:black; }
.world-nameplate-hp { width:46px; height:6px; border-width:1px; border-color:rgb(17,32,39); background-color:rgb(57,65,71); }
.world-nameplate-hp-fill { height:100%; background-color:rgb(82,209,104); }
.world-nameplate--group .world-nameplate-copy { color:rgb(120,255,124); }
.world-nameplate--hostile .world-nameplate-copy { color:rgb(255,115,92); }
.world-damage-copy {
    margin:0; padding:0; font-size:22px; white-space:nowrap;
    -unity-font-definition:url('../Fonts/jeffe-sdf.asset');
    -unity-text-outline-width:1px; -unity-text-outline-color:black;
    color:rgb(255,231,94);
}
.world-damage--incoming .world-damage-copy { color:rgb(255,97,82); }
.world-speech {
    min-width:100px; max-width:300px; min-height:19px;
    padding:10px; align-items:center; justify-content:center;
    background-image:url('../Artwork/en/gameplay/speech/freechat_box.png');
    -unity-background-scale-mode:stretch-to-fill;
    -unity-slice-left:6; -unity-slice-right:6; -unity-slice-top:6; -unity-slice-bottom:6;
}
.world-speech--ordinary { background-image:url('../Artwork/en/gameplay/speech/barker_box.png'); }
.world-speech--ordinary .world-speech-tail { background-image:url('../Artwork/en/gameplay/speech/barker_tail.png'); }
.world-speech--quest { background-image:url('../Artwork/en/gameplay/speech/quick-chat-box.png'); }
.world-speech-copy {
    margin:0; padding:0; white-space:normal; font-size:14px; color:black;
    -unity-font-definition:url('../Fonts/jeffe-sdf.asset');
    -unity-text-align:middle-center;
}
.world-speech-tail {
    position:absolute; left:50%; top:100%; margin-left:-4px; width:5px; height:20px;
    -unity-background-scale-mode:stretch-to-fill;
    background-image:url('../Artwork/en/gameplay/speech/freechat_tail.png');
}
.world-speech--quest .world-speech-tail { background-image:url('../Artwork/en/gameplay/speech/quick-chat-tail.png'); }
.world-annotations--hidden { display:none; }
.ff-chat-message { color:white; }
.ff-chat-message--receive { color:rgb(255,128,0); }
.ff-chat-message--attack { color:rgb(96,194,255); }
.world-warp-bars {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}
.world-warp-bar { position: absolute; height: 10%; left: 0; right: 0; background-color: black; }
.world-warp-top { top: 0; }
.world-warp-bottom { bottom: 0; }
.world-use-trigger { position: absolute; width: 37px; height: 52px; left: 50%; top: 50%; translate: -50% -50%; display: none; }
.world-location-caption {
    position: absolute; top: 40%; left: 0; right: 0; height: 50px; -unity-text-align: middle-center;
    -unity-font-definition: url('../Fonts/jeffe-sdf.asset'); color: white; font-size: 28px;
    -unity-text-outline-width: 1px; -unity-text-outline-color: black;
}
.world-launcher { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.world-launcher-cross { position: absolute; width: 660px; height: 660px; left: 50%; top: 50%; translate: -50% -50%; background-image: url('../Artwork/en/launcher/crosshair.png'); }
.world-launcher-gauge { position: absolute; width: 169px; height: 595px; left: 50%; top: 50%; translate: -509px -300px; background-image: url('../Artwork/en/launcher/gauge.png'); }
.world-launcher-power { position: absolute; width: 87px; height: 31px; left: 42px; background-image: url('../Artwork/en/launcher/gauge-bar.png'); }
