.ff-frontend-dialog-panel {
    position:absolute;
    transform-origin:0 0;
    -unity-background-scale-mode:stretch-to-fill;
}
.ff-frontend-dialog--registration .ff-frontend-dialog-panel {
    width:510px; height:245px;
    background-color:rgba(8,26,43,0.98);
}
.ff-frontend-dialog--delete .ff-frontend-dialog-panel {
    width:526px; height:164px;
    background-image:url('../Artwork/en/character/selection/controls/CSDeleteWindow.png');
}
.ff-frontend-registration, .ff-frontend-delete { display:none; position:absolute; left:0; top:0; right:0; bottom:0; }
.ff-frontend-dialog--registration .ff-frontend-registration,
.ff-frontend-dialog--delete .ff-frontend-delete { display:flex; }
.ff-frontend-registration-text, .ff-frontend-delete-prompt {
    position:absolute;
    -unity-font-definition:url('../Fonts/chaletbook-regular-sdf.asset');
    -unity-text-align:middle-center;
}
.ff-frontend-registration-text { left:30px; top:30px; width:450px; height:145px; font-size:16px; }
.ff-frontend-registration-close { position:absolute; left:165px; top:190px; width:180px; height:30px; }
.ff-frontend-registration-close:hover,
.ff-frontend-registration-close:focus { color:rgb(0,49,82); }
.ff-frontend-delete-title, .ff-frontend-delete-prompt {
    position:absolute; font-size:12px; -unity-text-align:middle-center;
}
.ff-frontend-delete-title { left:100px; top:12px; width:326px; height:22px; }
.ff-frontend-delete-prompt { left:45px; top:34px; width:436px; height:30px; }
.ff-frontend-delete-name { position:absolute; left:75px; top:73px; width:378px; height:24px; font-size:12px; }
.ff-frontend-delete-name > .unity-text-field__input { -unity-text-align:middle-center; }
.ff-frontend-delete-cancel, .ff-frontend-delete-confirm {
    position:absolute; top:125px; width:152px; height:27px; font-size:12px;
    -unity-background-scale-mode:stretch-to-fill;
    -unity-slice-left:5; -unity-slice-right:5; -unity-slice-top:5; -unity-slice-bottom:5;
}
.ff-frontend-delete-cancel { left:40px; background-image:url('../Artwork/en/character/selection/controls/CancelNormal.png'); }
.ff-frontend-delete-confirm { left:335px; background-image:url('../Artwork/en/character/selection/controls/red_button_normal.png'); }
.ff-frontend-delete-confirm:hover, .ff-frontend-delete-confirm:focus, .ff-frontend-delete-confirm:active {
    background-image:url('../Artwork/en/character/selection/controls/red_button_over.png');
}
