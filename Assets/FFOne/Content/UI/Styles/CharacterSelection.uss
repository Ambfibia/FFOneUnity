/* Screen-local positions remain editable in CharacterSelection.uxml. */
#character-selection .ff-label, #character-selection .ff-button { position: absolute; font-size: 12px; }
#character-selection .ff-label { color: rgb(204, 255, 255); -unity-text-align: middle-center; }
#character-selection .selection-padded { padding: 4px 6px 6px 10px; }
#character-selection .selection-detail { -unity-text-align: middle-left; }
#character-selection #selection-title { color: rgb(0, 0, 103); }
#character-selection #selected-avatar-name, #character-selection #enter-world { font-size: 14px; }
